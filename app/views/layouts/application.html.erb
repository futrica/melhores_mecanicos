<!DOCTYPE html>
<html lang="pt-BR" class="h-full bg-slate-50 antialiased">
  <head>
    <title><%= content_for(:title) || "Melhores Mecânicos | Encontre Oficinas Mecânicas de Confiança Sem Intermediários" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:meta_description) || "Encontre as melhores oficinas mecânicas, auto centers e mecânicos especializados em todo o Brasil. Avaliações reais, serviços e contato direto via WhatsApp sem comissões." %>">
    <meta name="robots" content="<%= content_for(:meta_robots) || "index, follow" %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Melhores Mecânicos">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="turbo-cache-control" content="<%= user_signed_in? ? 'no-cache' : 'no-preview' %>">
    <%= csrf_meta_tags %>
    <link rel="canonical" href="<%= content_for(:canonical_url) || request.original_url.split('?').first %>">

    <!-- OpenGraph Tags -->
    <meta property="og:title" content="<%= content_for(:title) || "Melhores Mecânicos | Encontre Oficinas Mecânicas de Confiança" %>">
    <meta property="og:description" content="<%= content_for(:meta_description) || "Conectamos você direto à oficina mecânica ou mecânico autônomo. 0% de comissão, orçamento direto no WhatsApp e transparência total." %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= request.original_url.split('?').first %>">
    <meta property="og:locale" content="pt_BR">
    <meta property="og:site_name" content="Melhores Mecânicos">

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon-48.png" type="image/png" sizes="48x48">
    <link rel="icon" href="/icon.png" type="image/png" sizes="192x192">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%= stylesheet_link_tag "tailwind", "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= adsense_script_tag %>
    <%= google_analytics_tag %>
  </head>

  <body class="flex flex-col min-h-screen text-slate-800 bg-slate-50 font-sans selection:bg-[#00A1FC] selection:text-white">
    <%= render "shared/impersonation_banner" %>
    
    <!-- Header Navbar - Porto Seguro Blue Theme -->
    <header class="sticky top-0 z-50 bg-[#093892] text-white shadow-lg border-b border-[#00A1FC]/20" data-controller="menu">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 sm:h-20">
          
          <!-- Logo com Monograma MM e Tipografia Porto Seguro Auto -->
          <a href="/" class="flex items-center gap-2.5 font-black tracking-tight text-xl sm:text-2xl text-white group" title="Melhores Mecânicos - Início">
            <img src="/icon.svg" alt="Melhores Mecânicos" class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl shadow-md shadow-[#00A1FC]/30 group-hover:scale-105 transition-transform">
            <div class="flex items-baseline flex-nowrap whitespace-nowrap">
              <span class="text-white font-black tracking-tight">Melhores</span><span class="text-[#00A1FC] font-black tracking-tight">Mecanicos</span>
            </div>
          </a>

          <!-- Desktop Navigation -->
          <nav class="hidden md:flex items-center space-x-6 text-sm font-semibold">
            <a href="/" class="text-blue-100 hover:text-white hover:bg-white/10 px-3 py-2 rounded-lg transition-colors">
              Início
            </a>

            <% if can_claim_company? %>
              <a href="<%= new_claim_path %>" class="text-white hover:text-white bg-[#00A1FC] hover:bg-[#008ee0] px-3.5 py-1.5 rounded-lg transition-all text-xs font-bold flex items-center gap-1.5 shadow-sm">
                <span>⚡</span>
                <span>Reivindicar Oficina</span>
              </a>
            <% end %>

            <a href="<%= contact_path %>" class="text-blue-100 hover:text-white hover:bg-white/10 px-3 py-2 rounded-lg transition-colors">
              Contato
            </a>
          </nav>

          <!-- User Actions -->
          <div class="hidden sm:flex items-center gap-3">
            <% if user_signed_in? %>
              <%= link_to app_root_path, class: "bg-[#00A1FC] hover:bg-[#008ee0] text-white font-extrabold text-xs sm:text-sm px-4 py-2 rounded-lg shadow-md transition-all flex items-center gap-1.5" do %>
                <span>👤</span> Painel
              <% end %>
              <%= link_to "Sair", destroy_user_session_path, data: { turbo_method: :delete }, class: "text-blue-200 hover:text-white text-xs font-medium px-2 py-1" %>
            <% else %>
              <%= link_to new_user_session_path, class: "bg-white hover:bg-blue-50 text-[#093892] font-black text-xs sm:text-sm px-4 py-2 rounded-lg shadow-md transition-all flex items-center gap-1.5" do %>
                <span>🔑</span> Entrar
              <% end %>
            <% end %>
          </div>

          <!-- Mobile Menu Button -->
          <div class="md:hidden flex items-center gap-2">
            <button type="button" class="p-2 rounded-lg text-blue-200 hover:text-white hover:bg-white/10 focus:outline-none" data-action="click->menu#toggle" aria-label="Abrir Menu">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Mobile Menu Dropdown -->
      <div class="hidden md:hidden bg-[#072461] border-t border-blue-900/60 px-4 pt-3 pb-6 space-y-2 text-sm" data-menu-target="links">
        <a href="/" class="block text-white hover:bg-white/10 px-3 py-2 rounded-md font-medium">Início</a>
        <% if can_claim_company? %>
          <a href="<%= new_claim_path %>" class="block text-white bg-[#00A1FC] px-3 py-2 rounded-md font-bold text-center">⚡ Reivindicar Minha Oficina</a>
        <% end %>
        <a href="<%= contact_path %>" class="block text-white hover:bg-white/10 px-3 py-2 rounded-md font-medium">Contato</a>
        <div class="pt-2 border-t border-blue-900/50 flex flex-col gap-2">
          <% if user_signed_in? %>
            <%= link_to "Meu Painel", app_root_path, class: "block bg-[#00A1FC] text-white font-bold text-center py-2.5 rounded-lg" %>
            <%= link_to "Sair", destroy_user_session_path, data: { turbo_method: :delete }, class: "block text-center text-blue-300 py-1 text-xs" %>
          <% else %>
            <%= link_to "Entrar na Conta", new_user_session_path, class: "block bg-white text-[#093892] font-black text-center py-2.5 rounded-lg" %>
          <% end %>
        </div>
      </div>
    </header>

    <!-- Main Content Body -->
    <main class="flex-grow">
      <% if flash[:notice].present? %>
        <div class="max-w-7xl mx-auto px-4 mt-4">
          <div class="bg-blue-50 text-[#093892] border border-[#00A1FC]/30 px-4 py-3 rounded-xl font-medium text-sm flex items-center gap-2 shadow-sm">
            <span class="text-base">✅</span>
            <span><%= flash[:notice] %></span>
          </div>
        </div>
      <% end %>
      <% if flash[:alert].present? %>
        <div class="max-w-7xl mx-auto px-4 mt-4">
          <div class="bg-rose-50 text-rose-800 border border-rose-200 px-4 py-3 rounded-xl font-medium text-sm flex items-center gap-2 shadow-sm">
            <span class="text-base">⚠️</span>
            <span><%= flash[:alert] %></span>
          </div>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <!-- Footer - Porto Seguro Dark Blue -->
    <footer class="bg-[#051d4d] text-slate-300 border-t border-[#093892] pt-12 pb-8 mt-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 pb-10 border-b border-blue-900/60">
          
          <!-- Column 1: Brand & Mission -->
          <div class="space-y-4">
            <a href="/" class="flex items-center gap-2.5 font-black tracking-tight text-xl sm:text-2xl text-white">
              <img src="/icon.svg" alt="Melhores Mecânicos" class="w-8 h-8 rounded-lg">
              <div class="flex items-baseline">
                <span class="text-white font-extrabold">Melhores</span><span class="text-[#00A1FC] font-black">Mecanicos</span>
              </div>
            </a>
            <p class="text-xs text-slate-300 leading-relaxed">
              O portal de referência para proprietários de veículos encontrarem oficinas mecânicas, auto centers e especialistas automotivos de confiança em todo o Brasil. Sem intermediários, você negocia diretamente pelo WhatsApp ou telefone.
            </p>
            <div class="pt-1 flex flex-col gap-2.5">
              <span class="inline-flex items-center gap-1.5 text-xs text-[#00A1FC] font-bold bg-[#00A1FC]/10 border border-[#00A1FC]/20 px-3 py-1.5 rounded-full w-fit">
                <span>🚗</span> MelhoresMecanicos
              </span>
            </div>
          </div>

          <!-- Column 2: Polos Automotivos & Cidades Populares -->
          <div>
            <h3 class="font-bold text-white text-sm tracking-wider uppercase mb-4 flex items-center gap-2">
              <span>📍</span> Cidades em Destaque
            </h3>
            <ul class="space-y-2 text-xs">
              <li><a href="/sp/sao-paulo" class="hover:text-[#00A1FC] transition-colors">Oficinas Mecânicas em São Paulo (SP)</a></li>
              <li><a href="/rj/rio-de-janeiro" class="hover:text-[#00A1FC] transition-colors">Oficinas Mecânicas no Rio de Janeiro (RJ)</a></li>
              <li><a href="/mg/belo-horizonte" class="hover:text-[#00A1FC] transition-colors">Oficinas Mecânicas em Belo Horizonte (MG)</a></li>
              <li><a href="/pr/curitiba" class="hover:text-[#00A1FC] transition-colors">Oficinas Mecânicas em Curitiba (PR)</a></li>
              <li><a href="/rs/porto-alegre" class="hover:text-[#00A1FC] transition-colors">Oficinas Mecânicas em Porto Alegre (RS)</a></li>
              <li><a href="/sp/campinas" class="hover:text-[#00A1FC] transition-colors">Auto Centers em Campinas (SP)</a></li>
            </ul>
          </div>

          <!-- Column 3: Navegue por Estados -->
          <div>
            <h3 class="font-bold text-white text-sm tracking-wider uppercase mb-4 flex items-center gap-2">
              <span>🗺️</span> Oficinas por Estado
            </h3>
            <div class="flex flex-wrap gap-1.5">
              <% (State.any? ? State.order(:acronym) : [
                OpenStruct.new(slug: "sp", acronym: "SP", name: "São Paulo"),
                OpenStruct.new(slug: "rj", acronym: "RJ", name: "Rio de Janeiro"),
                OpenStruct.new(slug: "mg", acronym: "MG", name: "Minas Gerais"),
                OpenStruct.new(slug: "pr", acronym: "PR", name: "Paraná"),
                OpenStruct.new(slug: "rs", acronym: "RS", name: "Rio Grande do Sul"),
                OpenStruct.new(slug: "sc", acronym: "SC", name: "Santa Catarina"),
                OpenStruct.new(slug: "ba", acronym: "BA", name: "Bahia"),
                OpenStruct.new(slug: "go", acronym: "GO", name: "Goiás"),
                OpenStruct.new(slug: "pe", acronym: "PE", name: "Pernambuco"),
                OpenStruct.new(slug: "ce", acronym: "CE", name: "Ceará"),
                OpenStruct.new(slug: "df", acronym: "DF", name: "Distrito Federal"),
                OpenStruct.new(slug: "es", acronym: "ES", name: "Espírito Santo")
              ]).each do |state| %>
                <a href="/<%= state.slug %>" class="bg-[#093892]/60 hover:bg-[#00A1FC] hover:text-white text-blue-100 text-xs font-semibold px-2.5 py-1 rounded transition-colors" title="Oficinas mecânicas em <%= state.name %>">
                  <%= state.acronym %>
                </a>
              <% end %>
            </div>
          </div>

          <!-- Column 4: Sobre / Institucional -->
          <div>
            <h3 class="font-bold text-white text-sm tracking-wider uppercase mb-4 flex items-center gap-2">
              <span>ℹ️</span> Informações
            </h3>
            <ul class="space-y-2.5 text-xs font-medium">
              <% if user_signed_in? %>
                <li><a href="<%= app_root_path %>" class="text-blue-300 hover:text-white transition-colors">Meu Painel</a></li>
              <% end %>
              <% if can_claim_company? %>
                <li>
                  <a href="<%= new_claim_path %>" class="text-[#00A1FC] hover:text-white font-bold transition-colors flex items-center gap-1">
                    <span>⚡</span> Reivindicar Minha Oficina
                  </a>
                </li>
              <% end %>
              <li><a href="<%= about_path %>" class="hover:text-[#00A1FC] transition-colors">Quem Somos</a></li>
              <li><a href="<%= terms_path %>" class="hover:text-[#00A1FC] transition-colors">Termos de Uso</a></li>
              <li><a href="<%= privacy_path %>" class="hover:text-[#00A1FC] transition-colors">Política de Privacidade</a></li>
              <li><a href="<%= contact_path %>" class="hover:text-[#00A1FC] transition-colors">Fale Conosco</a></li>
            </ul>
          </div>

        </div>

        <!-- RFB Public Data Transparency Banner -->
        <div class="my-6 p-4 rounded-xl bg-[#03153b] border border-[#093892] text-xs text-slate-300 space-y-1">
          <p class="font-bold text-white flex items-center gap-1.5">
            <span>📋</span> Transparência e Origem dos Dados Públicos (Receita Federal do Brasil)
          </p>
          <p class="leading-relaxed text-[11px] text-slate-300">
            Os cadastros e informações de oficinas mecânicas, auto centers e serviços automotivos exibidos neste portal são consolidados a partir de bases abertas públicas oficiais da Receita Federal do Brasil (RFB), sob os termos da Lei de Acesso à Informação (Lei nº 12.527/2011). O <strong>Melhores Mecânicos</strong> atua exclusivamente como diretório e índice informativo para aproximar motoristas e prestadores de serviços de forma direta. Se você é proprietário ou gestor da oficina e deseja atualizar seus contatos ou gerenciar sua página, <% if can_claim_company? %>acesse <a href="<%= new_claim_path %>" class="text-[#00A1FC] underline font-bold hover:text-white">Reivindicar Empresa</a><% else %>acesse seu painel de controle<% end %>.
          </p>
        </div>

        <!-- Footer Bottom Bar -->
        <div class="pt-4 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-400 gap-4 border-t border-blue-900/60">
          <p>&copy; <%= Time.current.year %> <strong>MelhoresMecanicos</strong>. Todos os direitos reservados.</p>
          <p class="text-slate-400">Conectando motoristas às melhores oficinas mecânicas de forma direta e sem intermediários.</p>
        </div>
      </div>
    </footer>

    <%= render "shared/contact_disclaimer_modal" %>
    <%= render "layouts/cookie_banner" %>
  </body>
</html>
