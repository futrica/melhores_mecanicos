<%# app/views/home/index.html.erb %>

<!-- HERO SECTION -->
<section class="relative bg-[#001F54] text-white py-12 lg:py-20 overflow-hidden">
  
  <!-- Ambient Glow Overlay -->
  <div class="absolute inset-0 z-0 bg-gradient-to-b from-[#00153B]/80 via-[#001F54]/90 to-[#00153B]"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    
    <!-- Hero Text -->
    <div class="max-w-3xl space-y-4 text-left">
      <div class="inline-flex items-center gap-2 bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 px-3.5 py-1.5 rounded-full text-xs font-bold tracking-wide uppercase shadow-sm backdrop-blur-md">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        <span>Economize nas suas férias com a Reserva Direta</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-none text-white">
        Reserve direto com a hospedagem. <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400">Sem taxas abusivas.</span>
      </h1>

      <p class="text-base sm:text-xl text-blue-100/90 leading-relaxed font-medium">
        As grandes plataformas de reservas online cobram até 25% de comissão dos hotéis. No <strong>Hospedagem Direta</strong>, você fala direto pelo WhatsApp ou telefone com a recepção, garante o menor preço e economiza em cada diária.
      </p>
    </div>

    <!-- Search Panel -->
    <div class="pt-2">
      <%= render 'shared/search_panel' %>
    </div>

    <!-- Trust Badges Bar -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-blue-900/60">
      <div class="flex items-center gap-3 bg-blue-950/50 backdrop-blur border border-blue-800/40 p-3.5 rounded-xl">
        <div class="w-10 h-10 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-xl font-bold">
          ⚡
        </div>
        <div>
          <h4 class="font-extrabold text-sm text-white">0% de Comissão</h4>
          <p class="text-xs text-blue-200">Sem intermediação nem taxas escondidas.</p>
        </div>
      </div>

      <div class="flex items-center gap-3 bg-blue-950/50 backdrop-blur border border-blue-800/40 p-3.5 rounded-xl">
        <div class="w-10 h-10 rounded-lg bg-blue-500/20 text-blue-300 flex items-center justify-center text-xl font-bold">
          💬
        </div>
        <div>
          <h4 class="font-extrabold text-sm text-white">Contato Direto no WhatsApp</h4>
          <p class="text-xs text-blue-200">Fale com o dono ou recepção em segundos.</p>
        </div>
      </div>

      <div class="flex items-center gap-3 bg-blue-950/50 backdrop-blur border border-blue-800/40 p-3.5 rounded-xl">
        <div class="w-10 h-10 rounded-lg bg-amber-500/20 text-amber-300 flex items-center justify-center text-xl font-bold">
          💰
        </div>
        <div>
          <h4 class="font-extrabold text-sm text-white">Menor Preço Garantido</h4>
          <p class="text-xs text-blue-200">Preços mais baixos do que em intermediários.</p>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- AdSense Top Banner -->
<div class="max-w-7xl mx-auto px-4 my-6">
  <%= adsense_ad_tag(:top) %>
</div>

<!-- VALUE PROPOSITION SECTION: Why Book Direct? -->
<section class="py-12 bg-white border-y border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <span class="text-xs font-extrabold uppercase tracking-widest text-emerald-600 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
        Vantagem Real
      </span>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Por que é mais inteligente reservar no <span class="text-blue-600">Hospedagem Direta</span>?
      </h2>
      <p class="text-slate-600 text-sm sm:text-base">
        Entenda a diferença entre pagar comissões para grandes agregadores e fechar direto com a pousada.
      </p>
    </div>

    <!-- Comparison Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      
      <!-- Card Intermediaries (The Problem) -->
      <div class="bg-rose-50/50 border border-rose-200 rounded-2xl p-6 sm:p-8 space-y-6 relative overflow-hidden">
        <div class="absolute top-0 right-0 bg-rose-500 text-white font-extrabold text-[10px] uppercase tracking-wider px-3 py-1 rounded-bl-xl shadow-sm">
          Plataformas de Reserva Online (OTAs)
        </div>
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center text-2xl font-bold">
            ❌
          </div>
          <div>
            <h3 class="font-extrabold text-lg text-slate-900">Reservando por Agências Intermediárias</h3>
            <p class="text-xs text-rose-700 font-medium">As taxas tornam tudo mais caro</p>
          </div>
        </div>

        <ul class="space-y-3 text-sm text-slate-700">
          <li class="flex items-start gap-2.5">
            <span class="text-rose-500 font-bold text-base mt-0.5">&bull;</span>
            <span><strong>Comissão de 15% a 25%</strong> repassada ao valor final da sua diária.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-rose-500 font-bold text-base mt-0.5">&bull;</span>
            <span>Atendimento impessoal e comunicação engessada por mensagens do aplicativo.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-rose-500 font-bold text-base mt-0.5">&bull;</span>
            <span>Dificuldade para negociar descontos, horários de check-in flexíveis ou mimos.</span>
          </li>
        </ul>
      </div>

      <!-- Card Hospedagem Direta (The Solution) -->
      <div class="bg-gradient-to-b from-emerald-50/70 to-white border-2 border-emerald-500/80 rounded-2xl p-6 sm:p-8 space-y-6 relative shadow-xl shadow-emerald-500/10">
        <div class="absolute top-0 right-0 bg-emerald-600 text-white font-extrabold text-[10px] uppercase tracking-wider px-3.5 py-1.5 rounded-bl-xl shadow-sm flex items-center gap-1">
          <span>⚡</span> Hospedagem Direta
        </div>
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-xl bg-emerald-500 text-white flex items-center justify-center text-2xl font-bold shadow-lg shadow-emerald-500/30">
            ✅
          </div>
          <div>
            <h3 class="font-extrabold text-lg text-slate-900">Reservando no Hospedagem Direta</h3>
            <p class="text-xs text-emerald-700 font-bold">100% Direto com o proprietário</p>
          </div>
        </div>

        <ul class="space-y-3 text-sm text-slate-700">
          <li class="flex items-start gap-2.5">
            <span class="text-emerald-600 font-bold text-base mt-0.5">✓</span>
            <span><strong>0% de comissão:</strong> O hotel não paga taxa e você ganha o menor preço.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-emerald-600 font-bold text-base mt-0.5">✓</span>
            <span>Fale na hora pelo <strong>WhatsApp ou Telefone</strong> direto com a recepção.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-emerald-600 font-bold text-base mt-0.5">✓</span>
            <span>Facilidade total para combinar upgrades, café da manhã especial e passeios locais.</span>
          </li>
        </ul>

        <!-- YouTube Video CTA -->
        <div class="pt-3 border-t border-emerald-100/80">
          <a href="https://www.youtube.com/watch?v=N2MpAi8AQSg" target="_blank" rel="noopener" class="w-full inline-flex items-center justify-between gap-2 bg-emerald-100/50 hover:bg-rose-50 border border-emerald-200/80 hover:border-rose-200 px-3.5 py-2.5 rounded-xl transition-all group">
            <span class="flex items-center gap-2 min-w-0">
              <svg class="w-5 h-5 text-rose-600 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
              <span class="text-xs font-semibold text-slate-800 group-hover:text-rose-700 truncate">Veja no vídeo como economizar sem taxas</span>
            </span>
            <span class="text-xs font-bold text-rose-600 group-hover:translate-x-0.5 transition-transform flex items-center gap-0.5 flex-shrink-0">
              Assista ↗
            </span>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- AdSense Inline Banner -->
<div class="max-w-7xl mx-auto px-4 my-6">
  <%= adsense_ad_tag(:inline) %>
</div>

<!-- STAY AT OUR TOP UNIQUE PROPERTIES (Acomodações em Destaque) -->
<section id="acomodacoes-destaque" class="py-14 bg-white border-t border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-1.5 text-xs font-extrabold uppercase tracking-widest text-emerald-600 mb-1">
          <span>✨</span> Hospedagens em Destaque
        </div>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
          Acomodações em Destaque &bull; Reserva Direta
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Propriedades verificadas que oferecem contato direto e 0% de taxa.
        </p>
      </div>
    </div>

    <!-- Featured Properties List -->
    <div class="space-y-4">
      <% @featured_companies.each do |company| %>
        <%= render 'shared/booking_company_card', company: company %>
      <% end %>
    </div>

  </div>
</section>

<!-- PUBLIC DATA TRANSPARENCY CARD -->
<section class="py-8 bg-slate-100 border-t border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white border border-slate-200/90 rounded-2xl p-6 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <div class="space-y-1.5 max-w-4xl">
        <div class="flex items-center gap-2 text-slate-900 font-extrabold text-sm">
          <span class="text-base">📋</span>
          <span>Transparência de Dados Públicos (Receita Federal do Brasil)</span>
        </div>
        <p class="text-xs text-slate-600 leading-relaxed">
          Os dados de CNPJ, endereço e telefone exibidos neste portal são oriundos de cadastros públicos oficiais da Receita Federal do Brasil. O <strong>Hospedagem Direta</strong> atua unicamente como um índice público para facilitar a conexão direta entre viajantes e hospedagens. Se você é proprietário ou gestor e identificou dados desatualizados ou deseja reivindicar o controle do perfil do seu estabelecimento, acesse a área de reivindicação.
        </p>
      </div>

      <% if can_claim_company? %>
        <a href="<%= new_claim_path %>" class="whitespace-nowrap px-4 py-2.5 bg-blue-50 hover:bg-blue-100 text-blue-900 font-extrabold text-xs border border-blue-200 rounded-xl transition-colors">
          Reivindicar Empresa
        </a>
      <% end %>
    </div>
  </div>
</section>

<!-- CALL TO ACTION FOR HOSTELIERS / PROPERTY OWNERS -->
<section class="py-16 bg-gradient-to-br from-[#00153B] via-[#001F54] to-blue-900 text-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <div class="lg:col-span-8 space-y-4 text-left">
        <span class="bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 font-extrabold text-xs px-3.5 py-1.5 rounded-full uppercase tracking-wider inline-block">
          Proprietário / Gerente de Hospedagem
        </span>

        <h2 class="text-3xl sm:text-5xl font-black tracking-tight leading-tight">
          Chega de pagar até 25% de comissão por cada reserva.
        </h2>

        <p class="text-blue-100 text-base sm:text-lg leading-relaxed">
          Reivindique a página da sua pousada, hotel ou chalé no <strong>Hospedagem Direta</strong>. Receba pedidos de reserva direto no seu WhatsApp, site ou telefone sem intermediários!
        </p>
      </div>

      <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-3 justify-end">
        <% if can_claim_company? %>
          <a href="<%= new_claim_path %>" class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-base py-4 px-6 rounded-2xl shadow-xl shadow-emerald-500/20 text-center transition-all flex items-center justify-center gap-2">
            <span>⚡</span>
            <span>Reivindicar Minha Hospedagem</span>
          </a>
        <% else %>
          <a href="<%= app_root_path %>" class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-base py-4 px-6 rounded-2xl shadow-xl shadow-emerald-500/20 text-center transition-all flex items-center justify-center gap-2">
            <span>👤</span>
            <span>Acessar Meu Painel</span>
          </a>
        <% end %>
        <a href="<%= contact_path %>" class="bg-blue-900/60 hover:bg-blue-900 text-white font-bold text-sm py-3 px-6 rounded-2xl border border-blue-700/50 text-center transition-all">
          Falar com Nossa Equipe
        </a>
      </div>

    </div>
  </div>
</section>
