<%# app/views/devise/registrations/edit.html.erb %>
<% content_for :title, "Editar Perfil | Hospedagem Direta" %>

<div class="auth-container" style="padding: 3rem 1.5rem;">
  <div class="auth-card" style="max-width: 520px;">
    <div class="auth-header">
      <div class="auth-icon-wrapper">
        ⚙️
      </div>
      <h2 class="auth-title">Editar Perfil</h2>
      <p class="auth-subtitle">
        Atualize seus dados de cadastro e segurança da conta
      </p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "auth-form" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="auth-field">
        <%= f.label :name, "Nome Completo", class: "auth-label" %>
        <%= f.text_field :name, autofocus: true, class: "auth-input", placeholder: "Seu nome completo" %>
      </div>

      <div class="auth-field">
        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.35rem;">
          <%= f.label :email, "Endereço de E-mail de Acesso", class: "auth-label", style: "margin-bottom: 0;" %>
          <span style="font-size: 0.72rem; font-weight: 700; color: #64748b; background: #f1f5f9; padding: 0.2rem 0.55rem; border-radius: 6px; border: 1px solid #e2e8f0; display: inline-flex; align-items: center; gap: 0.25rem;">
            <span>🔒</span> Chave de Login Fixa
          </span>
        </div>
        <%= f.email_field :email, readonly: true, disabled: true, class: "auth-input", style: "background-color: #f8fafc; color: #64748b; cursor: not-allowed; border-color: #cbd5e1; font-weight: 600;" %>
        <p style="font-size: 0.75rem; color: #64748b; margin-top: 0.35rem; line-height: 1.4;">
          O e-mail é a chave única de identificação e login da sua conta e não pode ser alterado por motivos de segurança.
        </p>
      </div>

      <div class="auth-field">
        <div style="display: flex; justify-content: space-between; align-items: baseline;">
          <%= f.label :phone, "Telefone / WhatsApp", class: "auth-label" %>
          <span style="font-size: 0.75rem; color: var(--text-dark); font-weight: 500;">(opcional - DDD + número)</span>
        </div>
        <%= f.telephone_field :phone, class: "auth-input", placeholder: "(11) 99999-8888", maxlength: 15 %>
      </div>

      <% if resource.provider.present? %>
        <div style="margin: 1.25rem 0; padding: 1rem 1.25rem; background: #f0fdf4; border: 1.5px solid #bbf7d0; border-radius: 14px; display: flex; align-items: center; gap: 0.85rem;">
          <span style="font-size: 1.6rem; flex-shrink: 0;">🌐</span>
          <div>
            <strong style="font-size: 0.88rem; color: #166534; display: block; margin-bottom: 0.15rem;">Conta conectada via Google</strong>
            <p style="font-size: 0.8rem; color: #15803d; margin: 0; line-height: 1.4;">
              Seu login é gerenciado de forma segura pelo Google OAuth. Você não precisa cadastrar senha aqui.
            </p>
          </div>
        </div>
      <% else %>
        <hr style="border: none; border-top: 1px dashed var(--bg-tertiary); margin: 0.5rem 0;">

        <div class="auth-field">
          <div style="display: flex; justify-content: space-between; align-items: baseline;">
            <%= f.label :password, "Nova Senha", class: "auth-label" %>
            <span style="font-size: 0.75rem; color: var(--text-dark); font-weight: 500;">(opcional, deixe em branco para manter a atual)</span>
          </div>
          <%= render "shared/password_input", form: f, field: :password, autocomplete: "new-password", placeholder: "••••••••" %>
        </div>

        <div class="auth-field">
          <%= f.label :password_confirmation, "Confirmar Nova Senha", class: "auth-label" %>
          <%= render "shared/password_input", form: f, field: :password_confirmation, autocomplete: "new-password", placeholder: "••••••••" %>
        </div>

        <hr style="border: none; border-top: 1px dashed var(--bg-tertiary); margin: 0.5rem 0;">

        <div class="auth-field">
          <div style="display: flex; justify-content: space-between; align-items: baseline;">
            <%= f.label :current_password, "Senha Atual", class: "auth-label" %>
            <span style="font-size: 0.75rem; color: #64748b; font-weight: 500;">(necessária apenas se for alterar a senha)</span>
          </div>
          <%= render "shared/password_input", form: f, field: :current_password, autocomplete: "current-password", placeholder: "Sua senha atual" %>
        </div>
      <% end %>

      <%= f.submit "Salvar Alterações", class: "auth-submit-btn" %>
    <% end %>

    <div class="auth-footer" style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.5rem;">
      <a href="<%= app_root_path %>" class="app-btn-secondary" style="font-size: 0.85rem; padding: 0.4rem 1rem;">← Voltar ao Painel</a>
    </div>

    <%# ===== CANCEL / DELETE ACCOUNT SECTION ===== %>
    <div style="margin-top: 2rem; border-top: 1px solid var(--bg-tertiary); padding-top: 1.5rem;">
      <h4 style="font-family: var(--font-title); font-size: 1rem; font-weight: 800; color: #ef4444; margin-bottom: 0.5rem;">⚠️ Cancelar Conta & Excluir Dados</h4>
      <p style="font-size: 0.85rem; color: var(--text-dark); margin-bottom: 0.75rem; line-height: 1.4;">
        Ao solicitar o cancelamento da sua conta, todos os seus dados cadastrais, <strong>lista de acomodações favoritas e avaliações enviadas também serão removidos permanentemente</strong> do nosso sistema.
      </p>
      <button type="button" id="open-cancel-modal" class="app-btn-unfav" style="width: 100%; justify-content: center; padding: 0.7rem; font-size: 0.9rem;">
        🗑 Excluir Minha Conta e Todos os Meus Dados
      </button>
    </div>
  </div>
</div>

<%# ===== MODAL DE CONFIRMAÇÃO DE EXCLUSÃO DE CONTA ===== %>
<div id="cancel-account-modal" class="modal-overlay" style="display: none;">
  <div class="modal-content" style="max-width: 480px;">
    <div class="modal-header">
      <h3 class="modal-title" style="color: #dc2626; display: flex; align-items: center; gap: 0.5rem;">
        <span>⚠️</span> Exclusão Irreversível de Conta
      </h3>
      <button type="button" id="close-cancel-modal" class="modal-close-btn">&times;</button>
    </div>
    
    <div class="modal-body" style="padding-top: 1rem;">
      <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 1rem; margin-bottom: 0.75rem;">
        <p style="font-size: 0.88rem; color: #991b1b; line-height: 1.5; margin: 0;">
          <strong>Esta ação é IRREVERSÍVEL!</strong> Sua conta, todas as suas acomodações favoritas e todas as avaliações enviadas também serão removidas permanentemente do banco de dados.
        </p>
      </div>

      <div class="auth-field">
        <label class="auth-label" style="color: var(--navy); font-size: 0.85rem; margin-bottom: 0.5rem; display: block;">
          Para confirmar, digite seu e-mail: <strong style="user-select: all; color: #dc2626;"><%= resource.email %></strong>
        </label>
        <input type="text" id="confirm-email-input" class="auth-input" placeholder="Digite seu e-mail exatamente como acima" autocomplete="off">
      </div>
    </div>

    <div class="modal-footer" style="display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.5rem;">
      <button type="button" id="cancel-modal-dismiss" class="app-btn-secondary" style="font-size: 0.85rem; padding: 0.6rem 1.2rem;">Cancelar</button>
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :delete, id: "delete-account-form", style: "display: inline;" }) do |f| %>
        <button type="submit" id="confirm-delete-btn" class="app-btn-unfav" style="background: #dc2626; color: white; border-color: #b91c1c; opacity: 0.5; cursor: not-allowed; font-size: 0.85rem; padding: 0.6rem 1.2rem;" disabled>
          🔥 Confirmar Exclusão Permanente
        </button>
      <% end %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', function() {
    const openBtn = document.getElementById('open-cancel-modal');
    const closeBtn = document.getElementById('close-cancel-modal');
    const dismissBtn = document.getElementById('cancel-modal-dismiss');
    const modal = document.getElementById('cancel-account-modal');
    const confirmInput = document.getElementById('confirm-email-input');
    const deleteBtn = document.getElementById('confirm-delete-btn');
    const targetEmail = "<%= resource.email %>".toLowerCase().trim();

    if (!openBtn || !modal) return;

    openBtn.addEventListener('click', function() {
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      if (confirmInput) {
        confirmInput.value = '';
        confirmInput.focus();
      }
      if (deleteBtn) {
        deleteBtn.disabled = true;
        deleteBtn.style.opacity = '0.5';
        deleteBtn.style.cursor = 'not-allowed';
      }
    });

    function closeModal() {
      modal.style.display = 'none';
      document.body.style.overflow = '';
    }

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (dismissBtn) dismissBtn.addEventListener('click', closeModal);

    modal.addEventListener('click', function(e) {
      if (e.target === modal) closeModal();
    });

    if (confirmInput && deleteBtn) {
      confirmInput.addEventListener('input', function() {
        const val = this.value.toLowerCase().trim();
        if (val === targetEmail) {
          deleteBtn.disabled = false;
          deleteBtn.style.opacity = '1';
          deleteBtn.style.cursor = 'pointer';
        } else {
          deleteBtn.disabled = true;
          deleteBtn.style.opacity = '0.5';
          deleteBtn.style.cursor = 'not-allowed';
        }
      });
    }
  });
</script>
