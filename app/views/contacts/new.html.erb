<%# app/views/contacts/new.html.erb %>
<% content_for :title, "Contato & Suporte | Hospedagem Direta" %>
<% content_for :meta_description, "Fale com a equipe do Hospedagem Direta. Envie suas dúvidas, sugestões, solicite suporte para a sua pousada ou hotel ou peça atualização de cadastro." %>

<div class="bg-slate-50 min-h-screen pb-16">
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-[#001F54] via-[#001845] to-[#00153B] text-white py-14 px-4 sm:px-6 lg:px-8 overflow-hidden">
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-blue-600/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-4xl mx-auto text-center relative z-10 space-y-3">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 font-bold text-xs sm:text-sm tracking-wide uppercase shadow-sm">
        <span>💬</span> Atendimento & Suporte
      </span>

      <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight leading-tight">
        Fale com a Nossa Equipe
      </h1>

      <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Estamos aqui para ajudar viajantes e proprietários de hospedagens. Envie sua mensagem, dúvida, sugestão ou solicitação de suporte.
      </p>
    </div>
  </section>

  <!-- Main Content Grid -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6 relative z-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Left Column: Info Cards (5 cols) -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Info Box 1: Atendimento via Formulário -->
        <div class="bg-white rounded-2xl p-6 shadow-xl shadow-slate-200/60 border border-slate-200/80 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-lg shadow-inner">
            ⚡
          </div>
          <h3 class="font-extrabold text-slate-900 text-base">Atendimento Rápido</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Para dúvidas gerais, sugestões ou solicitações de suporte, utilize o formulário ao lado. Sua mensagem chega diretamente para a nossa equipe de atendimento.
          </p>
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 bg-slate-100 px-2.5 py-1 rounded-md">
            <span>⏱️</span> Envio direto pelo portal
          </span>
        </div>

        <!-- Info Box 2: Proprietários de Hospedagens -->
        <div class="bg-gradient-to-br from-[#001F54] to-slate-950 text-white rounded-2xl p-6 shadow-xl space-y-3 relative overflow-hidden">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/20 border border-emerald-500/30 text-emerald-400 flex items-center justify-center font-bold text-lg shadow-inner">
            🏨
          </div>
          <h3 class="font-extrabold text-white text-base">É dono de Hotel ou Pousada?</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Se você deseja cadastrar sua pousada ou reivindicar a ficha do seu estabelecimento para incluir WhatsApp e fotos, você pode usar nosso fluxo rápido:
          </p>
          <% if can_claim_company? %>
            <%= link_to new_claim_path, class: "inline-flex items-center gap-1.5 text-xs font-bold text-emerald-400 hover:text-emerald-300 bg-emerald-500/10 border border-emerald-500/30 px-3 py-2 rounded-lg transition-all" do %>
              <span>⚡ Reivindicar Empresa Agora</span>
            <% end %>
          <% else %>
            <%= link_to app_root_path, class: "inline-flex items-center gap-1.5 text-xs font-bold text-emerald-400 hover:text-emerald-300 bg-emerald-500/10 border border-emerald-500/30 px-3 py-2 rounded-lg transition-all" do %>
              <span>👤 Acessar Meu Painel</span>
            <% end %>
          <% end %>
        </div>

        <!-- Info Box 3: Localização & Atendimento -->
        <div class="bg-white rounded-2xl p-6 shadow-xl shadow-slate-200/60 border border-slate-200/80 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-700 flex items-center justify-center font-bold text-lg shadow-inner">
            🇧🇷
          </div>
          <h3 class="font-extrabold text-slate-900 text-base">Abrangência Nacional</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Atendemos viajantes e estabelecimentos de hospedagem em todos os estados do Brasil de forma 100% digital e transparente.
          </p>
        </div>

      </div>

      <!-- Right Column: Contact Form (7 cols) -->
      <div class="lg:col-span-7">
        <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-xl shadow-slate-200/60 border border-slate-200/80 space-y-6">
          
          <div class="border-b border-slate-100 pb-4">
            <h2 class="text-xl font-extrabold text-slate-900">Envie uma Mensagem Direta</h2>
            <p class="text-xs sm:text-sm text-slate-500 font-medium">Preencha os campos abaixo e responderemos o mais breve possível.</p>
          </div>

          <%= form_with model: @contact, url: contacts_path, local: true, class: "space-y-4" do |f| %>
            
            <!-- Error messages -->
            <% if @contact.errors.any? %>
              <div class="bg-rose-50 text-rose-800 border border-rose-200 p-4 rounded-xl text-xs space-y-2">
                <p class="font-bold flex items-center gap-1.5 text-sm">
                  <span>⚠️</span> Por favor, corrija os erros abaixo:
                </p>
                <ul class="list-disc pl-4 space-y-1">
                  <% @contact.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <!-- Name -->
            <div class="space-y-1.5">
              <%= f.label :name, "Seu Nome Completo", class: "block text-xs font-bold text-slate-700 uppercase tracking-wide" %>
              <%= f.text_field :name, 
                    required: true, 
                    placeholder: "Ex: Maria Silva", 
                    class: "w-full text-sm px-4 py-3 rounded-xl border border-slate-300 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 outline-none transition-all bg-slate-50/50" %>
            </div>

            <!-- Email -->
            <div class="space-y-1.5">
              <%= f.label :email, "Seu E-mail de Contato", class: "block text-xs font-bold text-slate-700 uppercase tracking-wide" %>
              <%= f.email_field :email, 
                    required: true, 
                    placeholder: "Ex: maria@email.com", 
                    class: "w-full text-sm px-4 py-3 rounded-xl border border-slate-300 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 outline-none transition-all bg-slate-50/50" %>
            </div>

            <!-- Subject -->
            <div class="space-y-1.5">
              <%= f.label :subject, "Assunto da Mensagem", class: "block text-xs font-bold text-slate-700 uppercase tracking-wide" %>
              <%= f.text_field :subject, 
                    required: true, 
                    placeholder: "Ex: Dúvida sobre perfil, Atualização de cadastro, Sugestão", 
                    class: "w-full text-sm px-4 py-3 rounded-xl border border-slate-300 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 outline-none transition-all bg-slate-50/50" %>
            </div>

            <!-- Message -->
            <div class="space-y-1.5">
              <%= f.label :message, "Sua Mensagem", class: "block text-xs font-bold text-slate-700 uppercase tracking-wide" %>
              <%= f.text_area :message, 
                    required: true, 
                    rows: 5,
                    placeholder: "Escreva sua mensagem ou dúvida aqui com o máximo de detalhes possível...", 
                    class: "w-full text-sm px-4 py-3 rounded-xl border border-slate-300 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 outline-none transition-all bg-slate-50/50 resize-y" %>
            </div>

            <div class="pt-2">
              <%= f.submit "Enviar Mensagem", class: "w-full sm:w-auto bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-extrabold text-sm px-8 py-3.5 rounded-xl shadow-md shadow-emerald-500/20 transition-all cursor-pointer flex items-center justify-center gap-2" %>
            </div>
          <% end %>

        </div>
      </div>

    </div>
  </div>
</div>

