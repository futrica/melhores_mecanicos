<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background-color: #f4f6f9; color: #1e293b; margin: 0; padding: 20px; }
    .container { max-width: 650px; margin: 0 auto; background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05); border: 1px solid #e2e8f0; }
    .header { background: #0f172a; color: #ffffff; padding: 24px 30px; }
    .header h1 { margin: 0; font-size: 20px; font-weight: 600; letter-spacing: -0.5px; }
    .header p { margin: 6px 0 0 0; font-size: 13px; color: #94a3b8; }
    .badge-ok { display: inline-block; padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; margin-top: 12px; }
    .badge-warning { display: inline-block; padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; background: #fffbeb; color: #b45309; border: 1px solid #fde68a; margin-top: 12px; }
    .badge-danger { display: inline-block; padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; margin-top: 12px; }
    .content { padding: 30px; }
    .text-warning { color: #d97706; font-weight: 600; }
    .text-success { color: #16a34a; font-weight: 600; }
    .text-danger { color: #dc2626; font-weight: 600; }
    table { width: 100%; border-collapse: collapse; margin-top: 15px; }
    th { background: #f1f5f9; text-align: left; padding: 10px 12px; font-size: 12px; color: #475569; font-weight: 600; text-transform: uppercase; }
    td { padding: 12px; border-bottom: 1px solid #e2e8f0; font-size: 13px; }
    .footer { background: #f8fafc; padding: 15px 30px; font-size: 12px; color: #94a3b8; text-align: center; border-top: 1px solid #e2e8f0; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>🖥️ Relatório Diário de Saúde do Servidor</h1>
      <p>Servidor: <strong>servidor-projetos</strong> (EC2 i-0489d819554f966da - us-east-2)</p>
      <% if @stats[:status_level] == :danger %>
        <div class="badge-danger">🔴 ATENÇÃO: GARGALO DETECTADO</div>
      <% elsif @stats[:status_level] == :warning %>
        <div class="badge-warning">🟡 SAUDÁVEL COM ALERTA (<%= @stats[:status_text] %>)</div>
      <% else %>
        <div class="badge-ok">🟢 SAUDÁVEL E ESTÁVEL</div>
      <% end %>
    </div>
    
    <div class="content">
      <h3 style="margin-top:0; font-size:15px; color:#334155;">📊 Métricas Globais (Período Recente)</h3>
      
      <table style="margin-bottom: 25px;">
        <tr>
          <td style="font-weight:600;">Tempo Online (Uptime)</td>
          <td><%= @stats[:uptime] %></td>
        </tr>
        <tr>
          <td style="font-weight:600;">Load Average (CPU)</td>
          <td><%= @stats[:load_avg] %></td>
        </tr>
        <% if @stats[:cpu_credit_balance].present? %>
        <tr>
          <td style="font-weight:600;">Saldo de Créditos CPU AWS</td>
          <td>
            ~<%= @stats[:cpu_credit_balance] %>
            <span class="<%= @stats[:cpu_credit_balance] < 50 ? 'text-danger' : (@stats[:cpu_credit_balance] < 200 ? 'text-warning' : 'text-success') %>">
              (<%= @stats[:cpu_credit_balance] >= 500 ? 'Máximo' : (@stats[:cpu_credit_balance] < 50 ? 'Crítico' : 'Moderado') %>)
            </span>
          </td>
        </tr>
        <% end %>

        <tr>
          <td style="font-weight:600;">Memória RAM Usada</td>
          <td>
            <%= @stats[:ram_used_gb] %> GiB / <%= @stats[:ram_total_gb] %> GiB
            <span class="<%= @stats[:ram_pct] > 85 ? 'text-danger' : (@stats[:ram_pct] > 70 ? 'text-warning' : 'text-success') %>">
              (<%= @stats[:ram_free_gb] %> GiB Livres - <%= (100 - @stats[:ram_pct]).round(1) %>%)
            </span>
          </td>
        </tr>
        <tr>
          <td style="font-weight:600;">Armazenamento em Disco</td>
          <td>
            <%= @stats[:disk_used] %> / <%= @stats[:disk_total] %>
            <span class="<%= @stats[:disk_pct] > 85 ? 'text-danger' : (@stats[:disk_pct] > 70 ? 'text-warning' : 'text-success') %>">
              (<%= @stats[:disk_pct] %>% Ocupado - <%= @stats[:disk_avail] %> Livres)
            </span>
          </td>
        </tr>
      </table>

      <% if @stats[:containers].present? && @stats[:containers].any? %>
        <h3 style="margin-top:25px; margin-bottom:10px; font-size:15px; color:#334155;">🐳 Consumo por Container / Aplicação</h3>
        <table style="margin-bottom: 25px;">
          <thead>
            <tr>
              <th>Aplicação</th>
              <th>Uso de CPU</th>
              <th>Uso de RAM</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% @stats[:containers].each do |c| %>
              <tr>
                <td style="font-weight:600;"><%= c[:name] %></td>
                <td><%= c[:cpu_usage] %></td>
                <td><%= c[:ram_usage] %></td>
                <td><%= c[:status] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>

      <% if @stats[:recommendations].any? %>
        <div style="margin-top: 25px; padding: 15px; background: #fffbeb; border-left: 4px solid #f59e0b; border-radius: 4px;">
          <strong style="color: #b45309; font-size: 13px;">💡 Recomendações do Diagnóstico:</strong>
          <ul style="margin: 8px 0 0 0; padding-left: 20px; font-size: 13px; color: #92400e;">
            <% @stats[:recommendations].each do |rec| %>
              <li><%= rec.html_safe %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
    
    <div class="footer">
      Relatório gerado automaticamente pelo Sistema de Monitoramento Hospedagem Direta • <%= Time.current.in_time_zone("America/Sao_Paulo").strftime("%H:%M (BRT) - %d/%m/%Y") %>
    </div>
  </div>
</body>
</html>
