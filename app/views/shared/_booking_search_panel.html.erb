<%# app/views/shared/_booking_search_panel.html.erb %>
<div class="bg-[#003580] text-white pt-5 pb-7 px-4 sm:px-6 rounded-b-2xl shadow-xl mb-6" data-controller="search-form">
  <div class="max-w-7xl mx-auto">
    <!-- Booking Top Navigation Pills -->
    <div class="flex items-center gap-2 overflow-x-auto pb-4 scrollbar-none text-xs sm:text-sm font-semibold">
      <a href="/" class="flex items-center gap-2 bg-white/15 hover:bg-white/20 text-white px-4 py-2 rounded-full border border-white/25 transition-all shadow-sm whitespace-nowrap active-tab">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 7h-8v8H3V5H1v15h2v-3h18v3h2v-9a4 4 0 0 0-4-4zm-7 6H5V9h7v4z"/></svg>
        <span>Stays / Acomodações</span>
      </a>
      <a href="#" class="flex items-center gap-2 text-white/80 hover:text-white hover:bg-white/10 px-4 py-2 rounded-full transition-all whitespace-nowrap">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>
        <span>Flights</span>
      </a>
      <a href="#" class="flex items-center gap-2 text-white/80 hover:text-white hover:bg-white/10 px-4 py-2 rounded-full transition-all whitespace-nowrap">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.85 7h10.29l1.04 3H5.81l1.04-3zM19 17H5v-4h14v4z"/></svg>
        <span>Car rental</span>
      </a>
      <a href="#" class="flex items-center gap-2 text-white/80 hover:text-white hover:bg-white/10 px-4 py-2 rounded-full transition-all whitespace-nowrap">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
        <span>Attractions</span>
      </a>
      <a href="#" class="flex items-center gap-2 text-white/80 hover:text-white hover:bg-white/10 px-4 py-2 rounded-full transition-all whitespace-nowrap">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99z"/></svg>
        <span>Airport taxis</span>
      </a>
    </div>

    <!-- Golden Search Ribbon Bar Box -->
    <form action="/busca" method="get" class="bg-[#ffb700] p-1 sm:p-1.5 rounded-2xl shadow-2xl grid grid-cols-1 md:grid-cols-12 gap-1 text-slate-800 font-sans">
      
      <!-- 1. Destination Input -->
      <div class="md:col-span-4 bg-white rounded-xl p-2.5 flex items-center gap-3 border border-transparent focus-within:border-[#006ce4] focus-within:ring-2 focus-within:ring-[#006ce4]/30 transition-all shadow-sm">
        <div class="text-slate-500 text-xl pl-1">
          <svg class="w-6 h-6 stroke-current fill-none stroke-[2]" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0v-5a2 2 0 012-2h2a2 2 0 012 2v5m-6 0h6"/></svg>
        </div>
        <div class="flex-grow min-w-0">
          <label class="block text-[11px] font-semibold text-slate-500 leading-none mb-0.5">Destino / Cidade / Estado</label>
          <input type="text" name="q" value="<%= params[:q].presence || (@city&.name.presence || @state&.name) %>" placeholder="Para onde você vai?" class="w-full text-slate-900 font-bold text-sm sm:text-base outline-none bg-transparent placeholder-slate-400 truncate">
        </div>
        <% if @state %>
          <input type="hidden" name="state_id" value="<%= @state.id %>">
        <% end %>
      </div>

      <!-- 2. Select Dates Input -->
      <div class="md:col-span-4 bg-white rounded-xl p-2.5 flex items-center gap-3 border border-transparent focus-within:border-[#006ce4] focus-within:ring-2 focus-within:ring-[#006ce4]/30 transition-all shadow-sm cursor-pointer">
        <div class="text-slate-500 text-xl pl-1">
          <svg class="w-6 h-6 stroke-current fill-none stroke-[2]" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        </div>
        <div class="flex-grow min-w-0">
          <label class="block text-[11px] font-semibold text-slate-500 leading-none mb-0.5">Datas de Entrada e Saída</label>
          <div class="text-slate-900 font-bold text-xs sm:text-sm truncate">
            Sáb, 8 ago &mdash; Dom, 9 ago
          </div>
        </div>
      </div>

      <!-- 3. Occupancy Input -->
      <div class="md:col-span-3 bg-white rounded-xl p-2.5 flex items-center gap-3 border border-transparent focus-within:border-[#006ce4] focus-within:ring-2 focus-within:ring-[#006ce4]/30 transition-all shadow-sm cursor-pointer">
        <div class="text-slate-500 text-xl pl-1">
          <svg class="w-6 h-6 stroke-current fill-none stroke-[2]" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        </div>
        <div class="flex-grow min-w-0">
          <label class="block text-[11px] font-semibold text-slate-500 leading-none mb-0.5">Hóspedes & Quartos</label>
          <div class="text-slate-900 font-bold text-xs sm:text-sm truncate">
            2 adultos &middot; 0 crianças &middot; 1 quarto
          </div>
        </div>
      </div>

      <!-- 4. Submit Button -->
      <div class="md:col-span-1 flex items-stretch">
        <button type="submit" class="w-full bg-[#006ce4] hover:bg-[#0052b4] text-white font-extrabold text-base rounded-xl py-3 px-4 flex items-center justify-center gap-2 shadow-md transition-all hover:scale-[1.02] active:scale-95">
          <span>Buscar</span>
        </button>
      </div>

    </form>
  </div>
</div>
