<%
  current_state_id = (params[:state_id].presence || @state&.id)&.to_s
  preselected_state = @state || @states&.find { |s| s.id.to_s == current_state_id }
  state_btn_text = preselected_state ? "#{preselected_state.name} (#{preselected_state.acronym})" : "Selecione Estado"

  current_city_ids = Array(params[:city_ids].presence || params[:city_id].presence || @city&.id).reject(&:blank?).map(&:to_s)
  preselected_city_id = current_city_ids.first
  preselected_city = @city || (preselected_state && preselected_city_id.present? ? preselected_state.cities.find_by(id: preselected_city_id) : nil)
  city_btn_text = preselected_city ? preselected_city.name : (preselected_state ? "Selecionar cidade..." : "Selecione o estado")

  current_neighborhood_ids = Array(params[:neighborhood_ids].presence || params[:neighborhood_id].presence || @neighborhood&.id).reject(&:blank?).map(&:to_s)
  preselected_neighborhood = @neighborhood || (current_neighborhood_ids.one? ? Neighborhood.find_by(id: current_neighborhood_ids.first) : nil)
  neighborhood_btn_text = if preselected_neighborhood
                            preselected_neighborhood.name
                          elsif current_neighborhood_ids.size > 1
                            "#{current_neighborhood_ids.size} bairros"
                          elsif preselected_city
                            "Selecionar bairros..."
                          else
                            "Selecione a cidade"
                          end

  has_active_filters = params[:q].present? || preselected_city.present? || current_neighborhood_ids.any?
%>
<div class="w-full relative z-30 bg-white/95 backdrop-blur-md rounded-2xl shadow-xl border border-slate-200/90 p-4 sm:p-5 text-slate-800 transition-all"
     data-controller="search-form"
     data-search-form-initial-state-id-value="<%= current_state_id %>"
     data-search-form-initial-state-slug-value="<%= preselected_state&.slug %>"
     data-search-form-initial-city-id-value="<%= preselected_city_id %>"
     data-search-form-initial-city-slug-value="<%= preselected_city&.slug %>"
     data-search-form-initial-neighborhood-id-value="<%= current_neighborhood_ids.join(',') %>"
     data-search-form-initial-neighborhood-slug-value="<%= preselected_neighborhood&.slug %>"
     data-search-form-current-path-value="<%= request.path %>">
  
  <form action="/busca" method="get" data-action="submit->search-form#handleSubmit" class="space-y-3">

    <!-- Top mini header with dynamic clear button -->
    <div class="flex items-center justify-between text-xs">
      <div class="flex items-center gap-2 text-slate-700 font-extrabold uppercase tracking-wider text-[11px]">
        <span class="text-sm">🔍</span>
        <span>Localizar Oficina Mecânica</span>
      </div>
      <button type="button" 
              data-search-form-target="clearBtn" 
              data-action="click->search-form#clearForm" 
              class="<%= has_active_filters ? '' : 'hidden' %> text-slate-400 hover:text-rose-600 font-bold transition-colors flex items-center gap-1 cursor-pointer">
        <span>✕</span>
        <span>Limpar filtros</span>
      </button>
    </div>

    <!-- Main Search Grid: Balanced 12-columns bar in desktop -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-2.5 items-end">
      
      <!-- 1. Mechanic Name Input (q) -->
      <div class="sm:col-span-2 lg:col-span-4 space-y-1">
        <label for="search-q" class="block text-[11px] font-bold uppercase tracking-wider text-slate-600">Nome da Oficina</label>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400 pointer-events-none text-sm">🔧</span>
          <input type="text" 
                 name="q" 
                 id="search-q" 
                 value="<%= params[:q] %>" 
                 placeholder="Ex: Mecânica Silva, Bosch Car Service..." 
                 data-search-form-target="queryInput"
                 data-action="input->search-form#handleQueryInput keydown->search-form#handleQueryKeydown"
                 class="w-full pl-9 pr-8 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm font-semibold text-slate-800 focus:ring-2 focus:ring-[#00A1FC] focus:border-[#00A1FC] focus:bg-white transition-all placeholder:text-slate-400 placeholder:font-normal">
          <button type="button" 
                  data-search-form-target="clearQueryBtn" 
                  data-action="click->search-form#clearQuery" 
                  class="<%= params[:q].present? ? '' : 'hidden' %> absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700 text-[10px] font-bold w-4 h-4 rounded-full bg-slate-200 hover:bg-slate-300 flex items-center justify-center transition-colors cursor-pointer"
                  title="Limpar nome">
            ✕
          </button>
        </div>
      </div>

      <!-- 2. State Dropdown -->
      <div class="sm:col-span-1 lg:col-span-2 space-y-1 relative">
        <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-600">Estado <span class="text-rose-500">*</span></label>
        <div class="relative" data-search-form-target="stateDropdown">
          <input type="hidden" name="state_id" id="search-state" data-search-form-target="stateInput" value="<%= current_state_id %>">
          <input type="hidden" name="state_slug" data-search-form-target="stateSlugInput" value="<%= preselected_state&.slug %>">
          
          <button type="button" 
                  class="w-full text-left pl-8 pr-3 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm font-semibold text-slate-800 hover:bg-slate-100 focus:ring-2 focus:ring-[#00A1FC] transition-all flex items-center justify-between cursor-pointer" 
                  data-search-form-target="stateSelectBtn" 
                  data-action="click->search-form#toggleStateDropdown">
            <span class="truncate" data-search-form-target="stateBtnText"><%= state_btn_text %></span>
            <span class="text-[9px] text-slate-400 ml-1">▼</span>
          </button>
          <span class="absolute inset-y-0 left-0 flex items-center pl-2.5 text-slate-400 pointer-events-none text-sm">📍</span>

          <!-- State Dropdown content -->
          <div class="city-dropdown-content-pane absolute left-0 right-0 top-full mt-1.5 bg-white rounded-xl shadow-2xl border border-slate-200 z-50 p-2 space-y-2 min-w-[220px]">
            <input type="text" class="w-full px-3 py-1.5 text-xs bg-slate-100 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#00A1FC]" placeholder="Filtrar estado..." data-search-form-target="stateSearch" data-action="input->search-form#filterStates">
            <div class="max-h-48 overflow-y-auto space-y-0.5 divide-y divide-slate-100" data-search-form-target="stateList">
              <% @states&.each do |state| %>
                <div class="state-option px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-blue-50 hover:text-[#093892] cursor-pointer rounded-lg transition-colors flex items-center justify-between" 
                     data-id="<%= state.id %>" 
                     data-slug="<%= state.slug %>"
                     data-name="<%= state.name %> (<%= state.acronym %>)" 
                     data-action="click->search-form#selectState">
                  <span><%= state.name %></span>
                  <span class="text-[10px] font-bold text-slate-400 uppercase"><%= state.acronym %></span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- 3. City Single Select Dropdown -->
      <div class="sm:col-span-1 lg:col-span-2 space-y-1 relative">
        <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-600">Cidade</label>
        <div class="relative" data-search-form-target="cityDropdown">
          <input type="hidden" name="city_id" id="search-city" data-search-form-target="cityInput" value="<%= preselected_city_id %>">
          <input type="hidden" name="city_slug" data-search-form-target="citySlugInput" value="<%= preselected_city&.slug %>">
          
          <button type="button" 
                  class="w-full text-left pl-8 pr-3 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm font-semibold text-slate-800 hover:bg-slate-100 disabled:opacity-60 disabled:cursor-not-allowed focus:ring-2 focus:ring-[#00A1FC] transition-all flex items-center justify-between cursor-pointer" 
                  data-search-form-target="citySelectBtn" 
                  data-action="click->search-form#toggleCityDropdown" 
                  <%= preselected_state ? '' : 'disabled' %>>
            <span class="truncate" data-search-form-target="cityBtnText"><%= city_btn_text %></span>
            <span class="text-[9px] text-slate-400 ml-1">▼</span>
          </button>
          <span class="absolute inset-y-0 left-0 flex items-center pl-2.5 text-slate-400 pointer-events-none text-sm">🏙️</span>

          <div class="city-dropdown-content-pane absolute left-0 right-0 top-full mt-1.5 bg-white rounded-xl shadow-2xl border border-slate-200 z-50 p-2 space-y-2 min-w-[220px]">
            <input type="text" class="w-full px-3 py-1.5 text-xs bg-slate-100 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#00A1FC]" placeholder="Filtrar cidade..." data-search-form-target="citySearch" data-action="input->search-form#filterCities">
            <div class="max-h-48 overflow-y-auto space-y-0.5 divide-y divide-slate-100 text-xs" data-search-form-target="cityList">
              <div class="px-3 py-2 text-xs text-slate-400 italic text-center">Carregando cidades...</div>
            </div>
          </div>
        </div>
      </div>

      <!-- 4. Neighborhood Select Dropdown -->
      <div class="sm:col-span-1 lg:col-span-2 space-y-1 relative">
        <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-600">Bairro / Região</label>
        <div class="relative" data-search-form-target="neighborhoodDropdown">
          <input type="hidden" name="neighborhood_slug" data-search-form-target="neighborhoodSlugInput" value="<%= preselected_neighborhood&.slug %>">
          
          <button type="button" 
                  class="w-full text-left pl-8 pr-7 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm font-semibold text-slate-800 hover:bg-slate-100 disabled:opacity-60 disabled:cursor-not-allowed focus:ring-2 focus:ring-[#00A1FC] transition-all flex items-center justify-between cursor-pointer" 
                  data-search-form-target="neighborhoodSelectBtn" 
                  data-action="click->search-form#toggleNeighborhoodDropdown" 
                  <%= preselected_city ? '' : 'disabled' %>>
            <span class="truncate" data-search-form-target="neighborhoodBtnText"><%= neighborhood_btn_text %></span>
            <span class="text-[9px] text-slate-400 ml-1">▼</span>
          </button>
          <span class="absolute inset-y-0 left-0 flex items-center pl-2.5 text-slate-400 pointer-events-none text-sm">🏘️</span>
          
          <span class="<%= current_neighborhood_ids.any? ? '' : 'hidden' %> absolute right-2 top-1/2 -translate-y-1/2 bg-[#093892] text-white text-[10px] font-extrabold w-5 h-5 rounded-full flex items-center justify-center pointer-events-none" data-search-form-target="neighborhoodCount">
            <%= current_neighborhood_ids.size %>
          </span>

          <div class="city-dropdown-content-pane absolute left-0 right-0 top-full mt-1.5 bg-white rounded-xl shadow-2xl border border-slate-200 z-50 p-2 space-y-2 min-w-[220px]">
            <input type="text" class="w-full px-3 py-1.5 text-xs bg-slate-100 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#00A1FC]" placeholder="Filtrar bairro..." data-search-form-target="neighborhoodSearch" data-action="input->search-form#filterNeighborhoods">
            <div class="max-h-48 overflow-y-auto space-y-0.5 text-xs" data-search-form-target="neighborhoodList">
              <div class="px-3 py-2 text-xs text-slate-400 italic text-center">Selecione uma cidade</div>
            </div>
          </div>
        </div>
      </div>

      <!-- 5. Submit Action Button -->
      <div class="sm:col-span-1 lg:col-span-2">
        <button type="submit" 
                class="w-full h-[42px] px-4 bg-[#093892] hover:bg-[#072d75] active:scale-[0.98] text-white font-black text-sm rounded-xl shadow-md shadow-[#093892]/20 hover:shadow-lg transition-all flex items-center justify-center gap-2 cursor-pointer">
          <span class="text-sm">🔍</span>
          <span>Buscar Oficinas</span>
        </button>
      </div>

    </div>
  </form>

  <!-- Modal: Estado obrigatório com foco dinâmico -->
  <div class="modal-overlay fixed inset-0 bg-slate-900/60 backdrop-blur-sm items-center justify-center z-50 p-4" data-search-form-target="stateRequiredModal" style="display: none;" data-action="click->search-form#closeStateRequiredModalOnOverlay">
    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 space-y-4 text-left border border-slate-200">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-blue-100 text-[#093892] flex items-center justify-center text-xl font-bold">
          📍
        </div>
        <div>
          <h3 class="font-extrabold text-slate-900 text-base">Selecione o Estado</h3>
          <p class="text-xs text-slate-500">Atenção antes de buscar</p>
        </div>
      </div>
      <p class="text-xs text-slate-600 leading-relaxed">
        Por favor, selecione um Estado para visualizar as oficinas mecânicas e centros automotivos da região com contato direto no WhatsApp.
      </p>
      <div class="flex items-center justify-end gap-3 pt-2">
        <button type="button" data-action="click->search-form#closeStateRequiredModal" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-lg transition-colors cursor-pointer">
          Fechar
        </button>
        <button type="button" data-action="click->search-form#openStateSelectFromModal" class="px-4 py-2 bg-[#093892] hover:bg-[#072d75] text-white font-bold text-xs rounded-lg transition-colors cursor-pointer">
          Selecionar Estado
        </button>
      </div>
    </div>
  </div>

</div>
