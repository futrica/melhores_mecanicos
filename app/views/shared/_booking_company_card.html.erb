<%# app/views/shared/_booking_company_card.html.erb %>
<%
  avg_rating = company.average_rating
  reviews_cnt = company.reviews.size
  categories = company.categories.to_a
  main_category = categories.first&.name || "Hospedagem"
  style = category_style_for(main_category)
%>

<div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-md transition-all p-4 flex flex-col md:flex-row gap-4 relative mb-4 font-sans text-slate-800 group">
  
  <!-- Left Thumbnail Image Container (~240px) -->
  <div class="relative flex-shrink-0 w-full md:w-64 h-52 rounded-xl overflow-hidden bg-slate-900 border border-slate-200 shadow-sm group-hover:shadow-md transition-shadow">
    <% if company.primary_photo_url.present? %>
      <img src="<%= company.primary_photo_url %>" alt="<%= company.name %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
    <% else %>
      <div class="w-full h-full flex flex-col items-center justify-center bg-gradient-to-br from-slate-800 to-slate-900 text-slate-400 p-4 text-center">
        <svg class="w-12 h-12 mb-2 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z" />
        </svg>
        <span class="text-xs font-medium text-slate-400">Oficina Mecânica</span>
      </div>
    <% end %>

    <!-- Floating Heart / Favorite Button (Top Right of Photo) -->
    <% if !user_signed_in? || current_user.client? %>
      <div class="absolute top-2.5 right-2.5 z-10">
        <% if user_signed_in? && current_user.client? %>
          <%= button_to toggle_favorite_path(company_id: company.id), method: :post, data: { turbo: false },
              class: "fav-btn-card #{ current_user.favorited?(company) ? 'fav-btn-card--active' : '' } w-9 h-9 bg-white/90 hover:bg-white text-slate-700 hover:text-rose-500 rounded-full flex items-center justify-center shadow-md transition-all hover:scale-110 active:scale-95",
              title: current_user.favorited?(company) ? "Remover dos favoritos" : "Salvar nos favoritos" do %>
            <span class="fav-heart text-base"><%= current_user.favorited?(company) ? "❤️" : "🤍" %></span>
            <span class="fav-label hidden"><%= current_user.favorited?(company) ? "Favorito" : "Favoritar" %></span>
          <% end %>
        <% else %>
          <a href="<%= new_user_session_path %>" class="fav-btn-card w-9 h-9 bg-white/90 hover:bg-white text-slate-700 hover:text-rose-500 rounded-full flex items-center justify-center shadow-md transition-all hover:scale-110 active:scale-95" title="Faça login para salvar nos favoritos">
            <span class="fav-heart text-base">🤍</span>
            <span class="fav-label hidden">Favoritar</span>
          </a>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Middle Details Container (Flex Grow) -->
  <div class="flex-grow flex flex-col justify-between space-y-2">
    <div>
      
      <!-- Title & Badges -->
      <div class="flex items-start justify-between gap-2 flex-wrap">
        <div class="flex items-center gap-2 flex-wrap">
          <h3 class="font-extrabold text-lg sm:text-xl text-[#006ce4] hover:underline leading-snug">
            <a href="<%= company_seo_path(company) %>"><%= company.trade_name.presence || company.legal_name %></a>
          </h3>

          <% if company.premium? %>
            <span class="bg-gradient-to-r from-amber-400 to-yellow-500 text-slate-950 text-[11px] font-black px-2.5 py-0.5 rounded-full inline-flex items-center gap-1 shadow-xs">
              ⭐ Destaque
            </span>
          <% end %>
          <% if company.approved? %>
            <span class="bg-emerald-100 text-emerald-800 text-[11px] font-extrabold px-2 py-0.5 rounded-full inline-flex items-center gap-1">
              ✓ Verificada
            </span>
          <% end %>

        </div>
      </div>

      <!-- Location Breadcrumb Line -->
      <div class="text-xs font-medium text-slate-600 mt-1 flex items-center gap-1.5 flex-wrap">
        <span>📍</span>
        <a href="/<%= company.state.slug %>" class="font-bold text-[#006ce4] hover:underline" title="Ver hospedagens em <%= company.state.name %>"><%= company.state.acronym %></a>
        <span>&rsaquo;</span>
        <a href="/<%= company.state.slug %>/<%= company.city.slug %>" class="font-bold text-[#006ce4] hover:underline" title="Ver hospedagens em <%= company.city.name %>"><%= company.city.name %></a>
        <% if company.neighborhood.present? %>
          <span>&rsaquo;</span>
          <a href="/<%= company.state.slug %>/<%= company.city.slug %>/<%= company.neighborhood.slug %>" class="font-bold text-[#006ce4] hover:underline" title="Ver hospedagens no bairro <%= company.neighborhood.name %>"><%= company.neighborhood.name %></a>
        <% end %>
        <% if company.street.present? %>
          <span class="text-slate-400">&bull;</span>
          <span class="text-slate-500 font-normal"><%= company.street %>, <%= company.number %></span>
        <% end %>
      </div>

      <!-- Category Badges -->
      <div class="mt-2.5 flex items-center gap-1.5 flex-wrap">
        <% if company.categories.any? %>
          <% company.categories.first(3).each do |cat| %>
            <% badge_style = category_style_for(cat.name) %>
            <span class="inline-flex items-center gap-1 text-[11px] font-bold text-slate-700 bg-slate-100 border border-slate-200/80 px-2.5 py-0.5 rounded-md">
              <span><%= badge_style[:icon] %></span>
              <span><%= cat.name %></span>
            </span>
          <% end %>
        <% else %>
          <span class="inline-flex items-center gap-1 text-[11px] font-bold text-slate-700 bg-slate-100 border border-slate-200/80 px-2.5 py-0.5 rounded-md">
            <span>🏨</span>
            <span>Hospedagem</span>
          </span>
        <% end %>
      </div>


      <!-- Review Endorsement Badges -->
      <% top_tags = company.top_review_tags(3) %>
      <% if top_tags.any? %>
        <div class="mt-2 flex items-center gap-1.5 flex-wrap">
          <% top_tags.each do |tag| %>
            <span class="inline-flex items-center gap-1 text-[11px] font-extrabold text-amber-900 bg-amber-50 border border-amber-200/80 px-2 py-0.5 rounded-md">
              <span><%= Review.tag_icon(tag) %></span>
              <span><%= tag %></span>
            </span>
          <% end %>
        </div>
      <% end %>



    </div>
  </div>

  <!-- Right Section: Rating Score & Price / CTA Box -->
  <div class="flex flex-col justify-between items-end min-w-[190px] border-t md:border-t-0 md:border-l border-slate-100 pt-3 md:pt-0 md:pl-4">
    
    <!-- Rating Score Box Header (Top Right) -->
    <div class="flex items-center gap-2.5 justify-end w-full">
      <% if avg_rating > 0 %>
        <div class="text-right leading-tight">
          <div class="font-extrabold text-slate-900 text-sm">
            <%= avg_rating >= 4.8 ? "Excelente" : (avg_rating >= 4.5 ? "Fabuloso" : (avg_rating >= 4.0 ? "Muito Bom" : (avg_rating >= 3.5 ? "Bom" : "Regular"))) %>
          </div>
          <div class="text-[11px] text-slate-500 font-medium"><%= reviews_cnt %> <%= reviews_cnt == 1 ? "avaliação" : "avaliações" %></div>
        </div>
        <div class="bg-[#001F54] text-white font-extrabold text-sm px-2.5 py-1.5 rounded-lg font-mono text-center shadow-sm flex items-center gap-1">
          <span class="text-amber-400 text-xs">★</span>
          <span><%= avg_rating %></span>
        </div>
      <% else %>
        <div class="text-right leading-tight">
          <div class="font-extrabold text-emerald-800 text-xs bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-md">
            ⚡ Reserva Direta
          </div>
        </div>
      <% end %>
    </div>

    <!-- Price & CTA Box Footer (Bottom Right) -->
    <div class="mt-4 md:mt-0 text-right w-full space-y-1">
      <div class="text-[11px] text-slate-500 font-semibold">Sem comissões ou intermediários</div>
      
      <div class="text-xs text-slate-500 font-bold">
        Diárias sob consulta
      </div>

      <div class="pt-2">
        <a href="<%= company_seo_path(company) %>" class="w-full bg-[#006ce4] hover:bg-[#0052b4] text-white font-extrabold text-sm py-2.5 px-4 rounded-xl flex items-center justify-center gap-1.5 shadow transition-all hover:scale-[1.02] active:scale-95">
          <span>Ver detalhes</span>
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
        </a>
      </div>
    </div>

  </div>

</div>
