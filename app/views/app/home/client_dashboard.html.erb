<%# app/views/app/home/client_dashboard.html.erb %>
<% content_for :title, "Painel do Cliente | Hospedagem Direta" %>

<div class="app-dashboard">

  <%# ===== HERO WELCOME ===== %>
  <div class="app-hero-card">
    <div class="app-hero-content">
      <span class="app-role-badge">🧳 Área do Hóspede</span>
      <h1>Bem-vindo(a), <%= current_user.name&.split&.first || "Cliente" %>!</h1>
      <p>Aqui você gerencia suas acomodações favoritas e suas avaliações.</p>
    </div>
    <div class="app-hero-stats">
      <div class="app-stat-card">
        <span class="app-stat-value">❤️ <%= @favorited_companies.count %></span>
        <span class="app-stat-label">Favoritos</span>
      </div>
      <div class="app-stat-card">
        <span class="app-stat-value">⭐ <%= @reviews.count %></span>
        <span class="app-stat-label">Avaliações</span>
      </div>
    </div>
  </div>

  <%# ===== UNCONFIRMED EMAIL NOTICE ===== %>
  <% unless current_user.confirmed? %>
    <div class="unconfirmed-email-banner" style="background: #fffbe5; border: 1.5px solid #f59e0b; border-radius: 0.75rem; padding: 1.25rem 1.5rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; box-shadow: var(--shadow-sm);">
      <div style="display: flex; align-items: center; gap: 0.85rem;">
        <span style="font-size: 1.8rem; flex-shrink: 0;">✉️</span>
        <div>
          <h4 style="font-family: var(--font-title); font-size: 1rem; font-weight: 800; color: #92400e; margin: 0 0 0.15rem 0;">Confirmação de E-mail Pendente</h4>
          <p style="font-size: 0.88rem; color: #78350f; margin: 0; line-height: 1.4;">
            Seu e-mail <strong><%= current_user.email %></strong> ainda não foi verificado. Confirme seu e-mail para conseguir favoritar acomodações e enviar avaliações.
          </p>
        </div>
      </div>
      <div>
        <%= button_to user_confirmation_path(user: { email: current_user.email }), method: :post, data: { turbo: false }, class: "app-btn-secondary", style: "border-color: #f59e0b; color: #92400e; background: #fef3c7; font-weight: 800;" do %>
          📩 Reenviar E-mail de Confirmação
        <% end %>
      </div>
    </div>
  <% end %>

  <%# ===== QUICK ACTIONS ===== %>
  <section class="app-quick-actions">
    <div class="app-quick-card">
      <div class="app-quick-icon">🔍</div>
      <h3>Buscar Hospedagens</h3>
      <p>Encontre os melhores hotéis, pousadas, chalés e resorts em todo o Brasil diretamente com os proprietários.</p>
      <a href="/" class="app-btn-secondary">Buscar Agora</a>
    </div>
    <div class="app-quick-card">
      <div class="app-quick-icon">⚙️</div>
      <h3>Minha Conta</h3>
      <p>E-mail: <strong><%= current_user.email %></strong><br>Membro desde <%= l(current_user.created_at, format: "%B/%Y") %>.</p>
      <%= link_to edit_user_registration_path, class: "app-btn-secondary" do %>Editar Perfil<% end %>
    </div>
  </section>

  <%# ===== FAVORITOS ===== %>
  <section class="app-section">
    <div class="app-section-header">
      <h2>❤️ Minhas Hospedagens Favoritas</h2>
      <a href="/" class="app-section-link">Buscar mais →</a>
    </div>

    <% if @favorited_companies.any? %>
      <div class="app-fav-grid">
        <% @favorited_companies.each do |company| %>
          <div class="app-fav-card">
            <div class="app-fav-header">
              <div class="app-fav-avatar">
                <%= company.trade_name.present? ? company.trade_name.first(2).upcase : "HD" %>
              </div>
              <div class="app-fav-info">
                <h3><a href="<%= company_seo_path(company) %>" class="app-company-link"><%= company.trade_name.presence || company.legal_name %></a></h3>
                <span class="app-fav-location">📍 <%= company.city.name %> - <%= company.state.acronym %></span>
              </div>
            </div>

            <% if company.categories.any? %>
              <div class="app-fav-tags">
                <% company.categories.first(2).each do |cat| %>
                  <% style = category_style_for(cat.name) %>
                  <span class="app-fav-tag" style="background: <%= style[:gradient] %>; color: white;">
                    <%= style[:icon] %> <%= cat.name %>
                  </span>
                <% end %>
              </div>
            <% end %>

            <% avg = company.average_rating %>
            <% if avg > 0 %>
              <div class="app-fav-rating">
                <div class="app-stars">
                  <% 5.times do |i| %>
                    <span class="app-star <%= i < avg.round ? "filled" : "" %>">★</span>
                  <% end %>
                </div>
                <span class="app-rating-val"><%= avg %></span>
              </div>
            <% end %>

            <div class="app-fav-actions">
              <a href="<%= company_seo_path(company) %>" class="app-btn-secondary">Ver Perfil</a>
              <%= button_to toggle_favorite_path(company_id: company.id), method: :post, data: { turbo: false }, class: "app-btn-unfav", title: "Remover dos favoritos" do %>
                🗑 Remover
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="app-empty-state">
        <div class="app-empty-icon">❤️</div>
        <h3>Nenhum favorito ainda</h3>
        <p>Navegue pelas acomodações e clique no coração para salvar suas hospedagens favoritas aqui.</p>
        <a href="/" class="app-btn-primary">Buscar Hospedagens</a>
      </div>
    <% end %>
  </section>

  <%# ===== MINHAS AVALIAÇÕES ===== %>
  <section class="app-section">
    <div class="app-section-header">
      <h2>⭐ Minhas Avaliações</h2>
    </div>

    <% if @reviews.any? %>
      <div class="app-reviews-list">
        <% @reviews.each do |review| %>
          <% company = review.company %>
          <div class="app-review-item">
            <div class="app-review-avatar">
              <%= company.trade_name.present? ? company.trade_name.first(2).upcase : "HD" %>
            </div>
            <div class="app-review-body">
              <div class="app-review-top">
                <div>
                  <h4><a href="<%= company_seo_path(company) %>" class="app-company-link"><%= company.trade_name.presence || company.legal_name %></a></h4>
                  <span class="app-review-location">📍 <%= company.city.name %> - <%= company.state.acronym %></span>
                </div>
                <div class="app-review-meta">
                  <div class="app-stars">
                    <% review.rating.times do %>
                      <span class="app-star filled">★</span>
                    <% end %>
                    <% (5 - review.rating).times do %>
                      <span class="app-star">★</span>
                    <% end %>
                  </div>
                  <span class="app-review-date"><%= review.created_at.strftime("%d/%m/%Y") %></span>
                </div>
              </div>

              <% if review.comment.present? %>
                <p class="app-review-comment">"<%= review.comment %>"</p>
              <% end %>

              <% tags = Array(review.tags).reject(&:blank?) %>
              <% if tags.any? %>
                <div class="app-review-tags">
                  <% tags.each do |tag| %>
                    <span class="app-review-tag positive"><%= Review.tag_icon(tag) %> <%= tag %></span>
                  <% end %>
                </div>
              <% end %>

              <div class="app-review-actions" style="margin-top: 0.85rem; display: flex; justify-content: flex-end;">
                <%= button_to review_path(review), method: :delete, data: { turbo: false, confirm: "Tem certeza que deseja excluir sua avaliação?" }, class: "app-btn-unfav", title: "Excluir avaliação" do %>
                  🗑 Excluir Avaliação
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="app-empty-state">
        <div class="app-empty-icon">⭐</div>
        <h3>Nenhuma avaliação ainda</h3>
        <p>Suas avaliações ajudam outros viajantes a escolherem as melhores hospedagens da região.</p>
        <a href="/" class="app-btn-primary">Ver Hospedagens</a>
      </div>
    <% end %>
  </section>

</div>

