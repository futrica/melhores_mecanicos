<% content_for :title, "Detalhes do Usuário ##{@user.id} | Admin" %>

<div class="app-dashboard">
  <div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div>
      <%= link_to "← Voltar para Lista de Usuários", app_admin_users_path, style: "font-weight: 700; color: var(--orange); text-decoration: none; display: inline-block; margin-bottom: 0.5rem;" %>
      <h1 style="font-family: var(--font-title); font-size: 1.8rem; font-weight: 800; color: var(--navy); margin: 0;">
        Usuário: <%= @user.name.presence || @user.email %> (#<%= @user.id %>)
      </h1>
    </div>
    <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
      <span class="admin-badge badge-<%= @user.role %>" style="font-size: 1rem; padding: 0.5rem 1rem;">
        <%= @user.role == "admin" ? "Administrador 👑" : (@user.role == "company" ? "Empresa 🏬" : "Cliente 👷") %>
      </span>
      <% if @user.role != "admin" %>
        <%= button_to impersonate_app_admin_user_path(@user), method: :post, data: { turbo: false, turbo_confirm: "Deseja personificar o usuário #{@user.name.presence || @user.email}?" }, style: "background: #f59e0b; color: white; font-weight: 800; font-size: 0.85rem; border: none; padding: 0.55rem 1.1rem; border-radius: 8px; cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem;" do %>
          <span>🎭</span> Personificar este Usuário
        <% end %>
      <% end %>
    </div>
  </div>

  <%# Profile Summary Card %>
  <div style="background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 12px; padding: 1.75rem; box-shadow: var(--shadow-sm); margin-bottom: 2rem;">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem;">
      <div>
        <span style="font-size: 0.85rem; color: var(--text-dark); text-transform: uppercase; font-weight: 700;">Nome Completo</span>
        <p style="font-size: 1.1rem; font-weight: 700; color: var(--navy); margin: 0.25rem 0 0 0;"><%= @user.name.presence || "Não informado" %></p>
      </div>

      <div>
        <span style="font-size: 0.85rem; color: var(--text-dark); text-transform: uppercase; font-weight: 700;">E-mail</span>
        <p style="font-size: 1.05rem; font-weight: 600; color: var(--navy); margin: 0.25rem 0 0 0;"><%= @user.email %></p>
      </div>

      <div>
        <span style="font-size: 0.85rem; color: var(--text-dark); text-transform: uppercase; font-weight: 700;">Telefone / WhatsApp</span>
        <p style="font-size: 1.05rem; font-weight: 600; color: var(--navy); margin: 0.25rem 0 0 0;"><%= @user.phone.presence || "Não informado" %></p>
      </div>

      <div>
        <span style="font-size: 0.85rem; color: var(--text-dark); text-transform: uppercase; font-weight: 700;">Confirmação de E-mail</span>
        <p style="margin: 0.25rem 0 0 0;">
          <% if @user.confirmed? %>
            <span class="admin-badge badge-success">✅ Confirmado em <%= l(@user.confirmed_at, format: "%d/%m/%Y às %H:%M") %></span>
          <% else %>
            <span class="admin-badge badge-warning">⏳ Pendente de verificação</span>
          <% end %>
        </p>
      </div>

      <div>
        <span style="font-size: 0.85rem; color: var(--text-dark); text-transform: uppercase; font-weight: 700;">Data de Cadastro</span>
        <p style="font-size: 1rem; color: var(--navy); margin: 0.25rem 0 0 0;"><%= l(@user.created_at, format: "%d de %B de %Y às %H:%M") %></p>
      </div>

      <div>
        <span style="font-size: 0.85rem; color: var(--text-dark); text-transform: uppercase; font-weight: 700;">Provedor de Autenticação</span>
        <p style="font-size: 1rem; color: var(--navy); margin: 0.25rem 0 0 0;"><%= @user.provider.present? ? "Google OAuth (#{@user.provider})" : "E-mail e Senha" %></p>
      </div>
    </div>
  </div>

</div>
