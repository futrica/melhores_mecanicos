<% content_for :title, "Histórico de E-mails Enviados | Administração" %>

<div class="app-dashboard">
  <div class="app-hero-card" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
    <div class="app-hero-content">
      <span class="app-role-badge">📧 Monitoramento de E-mails & Prospecção</span>
      <h1>E-mails de Apresentação de Empresas</h1>
      <p>Acompanhe em tempo real os disparos de prospecção, status de entrega e taxa de descadastramento (opt-out).</p>
    </div>
    <div class="app-hero-stats">
      <div class="app-stat-card">
        <span class="app-stat-value" style="color: #22c55e;">✅ <%= @total_sent %></span>
        <span class="app-stat-label">Enviados</span>
      </div>
      <div class="app-stat-card">
        <span class="app-stat-value" style="color: #6366f1;">🖱️ <%= @total_clicked %></span>
        <span class="app-stat-label">Cliques</span>
      </div>
      <div class="app-stat-card">
        <span class="app-stat-value" style="color: #ef4444;">❌ <%= @total_failed %></span>
        <span class="app-stat-label">Falhas / MX</span>
      </div>
      <div class="app-stat-card">
        <span class="app-stat-value" style="color: #eab308;">🛑 <%= @total_opt_outs %></span>
        <span class="app-stat-label">Opt-Outs</span>
      </div>
      <div class="app-stat-card">
        <span class="app-stat-value" style="color: #3b82f6;">🎯 <%= @eligible_remaining %></span>
        <span class="app-stat-label">Elegíveis Restantes</span>
      </div>
    </div>
  </div>

  <%= render "app/admin/admin_nav" %>

  <!-- Single Section Header & Filter Selector -->
  <div style="margin-bottom: 2rem;">
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.25rem;">
      <h2 style="font-size: 1.25rem; font-weight: 700; color: var(--text-main, #0f172a); margin: 0;">
        📬 Histórico de Envios & Opt-Outs
      </h2>

      <form method="get" action="<%= app_admin_outreach_logs_path %>" style="display: flex; align-items: center; gap: 0.75rem;">
        <label for="status" style="font-weight: 700; font-size: 0.88rem; color: #475569;">Filtrar Status:</label>
        <select name="status" id="status" onchange="this.form.submit()" style="padding: 0.55rem 1rem; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 0.88rem; font-weight: 600; background: white; color: #0f172a; cursor: pointer; box-shadow: 0 1px 2px rgba(0,0,0,0.05);">
          <option value="all" <%= 'selected' if @status_filter == 'all' %>>📋 Todos os Registros</option>
          <option value="sent" <%= 'selected' if @status_filter == 'sent' %>>✅ Enviados com Sucesso (<%= @total_sent %>)</option>
          <option value="clicked" <%= 'selected' if @status_filter == 'clicked' %>>🖱️ Clicaram no E-mail (<%= @total_clicked %>)</option>
          <option value="failed" <%= 'selected' if @status_filter == 'failed' %>>❌ Falhas / MX Inválido (<%= @total_failed %>)</option>
          <option value="opt_out" <%= 'selected' if @status_filter == 'opt_out' %>>🛑 Opt-Outs / Descadastrados (<%= @total_opt_outs %>)</option>
        </select>
      </form>
    </div>

    <!-- Unified Table -->
    <div style="background: var(--card-bg, #ffffff); border: 1px solid var(--card-border, #e2e8f0); border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);">
      <% if @records.any? %>
        <div style="overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
            <thead>
              <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #475569; font-weight: 600;">
                <th style="padding: 12px 16px;">Empresa</th>
                <th style="padding: 12px 16px;">Cidade/UF</th>
                <th style="padding: 12px 16px;">E-mail Destino</th>
                <th style="padding: 12px 16px;">Status / Ação</th>
                <th style="padding: 12px 16px;">Detalhes / Motivo</th>
                <th style="padding: 12px 16px;">Data / Hora</th>
              </tr>
            </thead>
            <tbody>
              <% @records.each do |record| %>
                <tr style="border-bottom: 1px solid #f1f5f9;">
                  <% if record.is_a?(CompanyOutreachLog) %>
                    <td style="padding: 12px 16px; font-weight: 600; color: #0f172a;">
                      <% if record.company.present? %>
                        <%= link_to (record.company.trade_name.presence || record.company.legal_name), app_admin_company_path(record.company), style: "color: #2563eb; text-decoration: none;" %>
                      <% else %>
                        —
                      <% end %>
                    </td>
                    <td style="padding: 12px 16px; color: #64748b;">
                      <%= record.company ? "#{record.company.city&.name} - #{record.company.state&.acronym}" : "—" %>
                    </td>
                    <td style="padding: 12px 16px; color: #334155; font-family: monospace;">
                      <%= record.email %>
                    </td>
                    <td style="padding: 12px 16px;">
                      <% if record.clicked_at.present? %>
                        <span style="background: #e0e7ff; color: #3730a3; padding: 4px 8px; border-radius: 9999px; font-size: 0.8rem; font-weight: 600;">
                          🖱️ Clicou em <%= record.clicked_at.strftime("%d/%m %H:%M") %>
                        </span>
                      <% else %>
                        <% case record.status %>
                        <% when 'sent' %>
                          <span style="background: #dcfce7; color: #166534; padding: 4px 8px; border-radius: 9999px; font-size: 0.8rem; font-weight: 600;">Enviado</span>
                        <% when 'failed' %>
                          <span style="background: #fee2e2; color: #991b1b; padding: 4px 8px; border-radius: 9999px; font-size: 0.8rem; font-weight: 600;">Falha SMTP</span>
                        <% when 'invalid_mx' %>
                          <span style="background: #fef3c7; color: #92400e; padding: 4px 8px; border-radius: 9999px; font-size: 0.8rem; font-weight: 600;">MX Inválido</span>
                        <% else %>
                          <span style="background: #f1f5f9; color: #475569; padding: 4px 8px; border-radius: 9999px; font-size: 0.8rem;"><%= record.status %></span>
                        <% end %>
                      <% end %>
                    </td>
                    <td style="padding: 12px 16px; color: #475569;">
                      <%= record.company&.views_count %> views
                    </td>
                    <td style="padding: 12px 16px; color: #64748b; font-size: 0.85rem;">
                      <%= (record.sent_at || record.created_at).strftime("%d/%m/%Y %H:%M") %>
                    </td>

                  <% elsif record.is_a?(CompanyEmailOptOut) %>
                    <td style="padding: 12px 16px; font-weight: 600; color: #0f172a;">
                      <% if record.company.present? %>
                        <%= link_to (record.company.trade_name.presence || record.company.legal_name), app_admin_company_path(record.company), style: "color: #2563eb; text-decoration: none;" %>
                      <% else %>
                        —
                      <% end %>
                    </td>
                    <td style="padding: 12px 16px; color: #64748b;">
                      <%= record.company ? "#{record.company.city&.name} - #{record.company.state&.acronym}" : "—" %>
                    </td>
                    <td style="padding: 12px 16px; color: #334155; font-family: monospace;">
                      <%= record.email %>
                    </td>
                    <td style="padding: 12px 16px;">
                      <span style="background: #fee2e2; color: #991b1b; padding: 4px 8px; border-radius: 9999px; font-size: 0.8rem; font-weight: 600;">🛑 Opt-Out</span>
                    </td>
                    <td style="padding: 12px 16px; color: #dc2626; font-size: 0.85rem; max-width: 250px;">
                      <strong>Motivo:</strong> <%= CompanyEmailOptOut::REASONS[record.reason] || record.reason || "Descadastrado" %>
                      <% if record.feedback.present? %>
                        <br/><span style="color: #64748b; font-style: italic;">"<%= record.feedback %>"</span>
                      <% end %>
                    </td>
                    <td style="padding: 12px 16px; color: #64748b; font-size: 0.85rem;">
                      <%= (record.unsubscribed_at || record.created_at).strftime("%d/%m/%Y %H:%M") %>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <!-- Pagination Footer -->
        <div style="padding: 1.25rem 1.5rem; border-top: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; background: #f8fafc;">
          <span style="font-size: 0.88rem; color: #64748b; font-weight: 600;">
            Mostrando <%= @records.size %> de <%= @pagy.count %> registros encontrados
          </span>
          <% if @pagy.present? && @pagy.pages > 1 %>
            <div style="display: flex; gap: 0.5rem;">
              <%== pagy_nav(@pagy) rescue nil %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div style="padding: 3rem; text-align: center; color: #64748b;">
          Nenhum registro encontrado para o filtro selecionado.
        </div>
      <% end %>
    </div>
  </div>
</div>
