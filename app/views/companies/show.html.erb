<%# app/views/companies/show.html.erb %>

<%
  trade_name_display = @company.trade_name.presence || @company.legal_name
  score_info = booking_score_info(@company)
  estimated_price = booking_estimated_price(@company)

  categories = @company.categories.to_a
  main_category = categories.first&.name || "Hotéis e Pousadas"
  main_style = category_style_for(main_category)

  clean_cnae = @company.cnae_principal.to_s.gsub(/\D/, "")
  mapped_cnae_name = Company::CNAE_MAPPINGS[clean_cnae]
  is_main_cnae_lodging = mapped_cnae_name.present?

  has_real_photos = @company.photos.attached? && @company.photos.any?
  is_verified_or_rich = @company.approved? || @company.is_claimed? || has_real_photos

  has_phone = (@company.phone_1.present? && is_valid_phone?(@company.phone_1)) || (@company.phone_2.present? && is_valid_phone?(@company.phone_2))

  page_title = if is_verified_or_rich
    if has_phone
      "#{trade_name_display} em #{@city.name} - #{@state.acronym} | Fotos, WhatsApp e Reserva Direta [Sem Taxas]"
    else
      "#{trade_name_display} em #{@city.name} - #{@state.acronym} | Fotos e Reserva Direta [Sem Taxas]"
    end
  elsif is_main_cnae_lodging
    if has_phone
      "#{trade_name_display} em #{@city.name} - #{@state.acronym} | Telefone, Endereço e Dados Cadastrais"
    else
      "#{trade_name_display} em #{@city.name} - #{@state.acronym} | Endereço, CNPJ e Dados Oficiais"
    end
  else
    if has_phone
      "#{trade_name_display} em #{@city.name}/#{@state.acronym}: Telefone, Endereço e CNPJ"
    else
      "#{trade_name_display} em #{@city.name}/#{@state.acronym}: Endereço, Situação Cadastral e CNPJ"
    end
  end

  meta_desc = if is_verified_or_rich
    if has_phone
      "Reserve direto em #{trade_name_display} em #{@city.name}/#{@state.acronym}. Fotos reais, acomodações e contato direto no WhatsApp sem taxas nem intermediários."
    else
      "Conheça #{trade_name_display} em #{@city.name}/#{@state.acronym}. Fotos reais da hospedagem, acomodações e informações completas para sua estadia."
    end
  elsif has_phone
    "Telefone, endereço e dados cadastrais de #{trade_name_display} (CNPJ: #{@company.cnpj}) em #{@city.name}/#{@state.acronym}. Confira contato, localização e informações oficiais."
  else
    "Informações cadastrais oficiais de #{trade_name_display} (CNPJ: #{@company.cnpj}) em #{@city.name}/#{@state.acronym}. Endereço, CNAE e situação cadastral na Receita Federal."
  end
%>

<% content_for :title, page_title %>
<% content_for :meta_description, meta_desc %>
<% content_for :meta_robots, (@company.indexable? ? "index, follow" : "noindex, follow") %>
<% content_for :canonical_url, "https://hospedagemdireta.com.br/#{@state.slug}/#{@city.slug}/#{@neighborhood&.slug || 'centro'}/#{@company.slug}" %>

<%
  breadcrumb_items = [
    { "@type" => "ListItem", "position" => 1, "name" => "Início", "item" => request.base_url },
    { "@type" => "ListItem", "position" => 2, "name" => @state.acronym, "item" => "#{request.base_url}/#{@state.slug}" },
    { "@type" => "ListItem", "position" => 3, "name" => @city.name, "item" => "#{request.base_url}/#{@state.slug}/#{@city.slug}" }
  ]

  if @neighborhood.present?
    breadcrumb_items << {
      "@type" => "ListItem",
      "position" => 4,
      "name" => @neighborhood.name,
      "item" => "#{request.base_url}/#{@state.slug}/#{@city.slug}/#{@neighborhood.slug}"
    }
  end

  breadcrumb_items << {
    "@type" => "ListItem",
    "position" => breadcrumb_items.size + 1,
    "name" => trade_name_display,
    "item" => request.original_url
  }

  lodging_hash = CompanySchemaMapper.new(@company, base_url: request.base_url, reviews: @reviews).to_schema_hash
%>

<script type="application/ld+json">
  <%= raw({
    "@context" => "https://schema.org",
    "@type" => "BreadcrumbList",
    "itemListElement" => breadcrumb_items
  }.to_json) %>
</script>

<script type="application/ld+json">
  <%= raw(lodging_hash.to_json) %>
</script>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 font-sans text-slate-800 pt-6 pb-16 space-y-6">

  <!-- Breadcrumbs Bar -->
  <nav class="flex items-center gap-1.5 text-xs font-medium text-slate-500 flex-wrap py-1 leading-relaxed">
    <a href="/" class="hover:text-[#006ce4] transition-colors">Início</a>
    <span class="text-slate-400">&rsaquo;</span>
    <a href="/<%= @state.slug %>" class="hover:text-[#006ce4] transition-colors"><%= @state.name %> (<%= @state.acronym %>)</a>
    <span class="text-slate-400">&rsaquo;</span>
    <a href="/<%= @state.slug %>/<%= @city.slug %>" class="hover:text-[#006ce4] transition-colors"><%= @city.name %></a>
    <% if @neighborhood.present? %>
      <span class="text-slate-400">&rsaquo;</span>
      <a href="/<%= @state.slug %>/<%= @city.slug %>/<%= @neighborhood.slug %>" class="hover:text-[#006ce4] transition-colors"><%= @neighborhood.name %></a>
    <% end %>
    <span class="text-slate-400">&rsaquo;</span>
    <span class="text-slate-900 font-extrabold"><%= trade_name_display %></span>
  </nav>

  <!-- AdSense Top Banner (Free Plan Only) -->
  <% if @company.free_plan? %>
    <%= adsense_ad_tag(:top) %>
  <% end %>

  <!-- Booking.com Style Header & Photo Gallery Grid Container -->
  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-4 sm:p-6 lg:p-8 space-y-6 relative">
    
    <!-- Top Header Bar (Title, Rating, Address, Top Right Actions) -->
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-4 border-b border-slate-100 pb-5">
      <div class="space-y-2">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="text-amber-400 font-extrabold text-sm flex items-center gap-0.5">
            ★★★★ <span class="bg-amber-100 text-amber-800 text-[10px] font-black px-1.5 py-0.5 rounded ml-1">👍</span>
          </span>
          <span class="inline-flex items-center gap-1 bg-emerald-50 text-emerald-800 border border-emerald-200/80 text-[11px] font-extrabold px-2.5 py-0.5 rounded-full">
            ⚡ Reserva Direta &bull; 0% Taxa
          </span>
          <% if @company.premium? %>
            <span class="inline-flex items-center gap-1 bg-gradient-to-r from-amber-400 to-yellow-500 text-slate-950 text-[11px] font-black px-2.5 py-0.5 rounded-full shadow-xs">
              ⭐ Hospedagem em Destaque
            </span>
          <% end %>
          <% if @company.approved? %>
            <span class="inline-flex items-center gap-1 bg-blue-50 text-blue-800 border border-blue-200/80 text-[11px] font-extrabold px-2.5 py-0.5 rounded-full">
              ✓ Hospedagem Verificada
            </span>
          <% end %>

          <% if @company.website.present? %>
            <% web_url = @company.website.start_with?('http') ? @company.website : "https://#{@company.website}" %>
            <a href="<%= web_url %>" target="_blank" rel="noopener" class="inline-flex items-center gap-1 bg-purple-50 hover:bg-purple-100 text-purple-900 border border-purple-200/80 text-[11px] font-extrabold px-2.5 py-0.5 rounded-full transition-colors">
              🌐 Website Oficial
            </a>
          <% end %>
        </div>

        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 tracking-tight leading-tight">
          <%= trade_name_display %>
        </h1>

        <div class="text-xs sm:text-sm font-medium text-slate-600 flex items-center gap-1.5 flex-wrap">
          <span class="font-bold text-slate-800">📍 <%= @company.street %>, <%= @company.number %> <%= "- #{@company.complement}" if @company.complement.present? %></span>
          <% if @neighborhood.present? %>
            <span>&bull;</span>
            <span class="font-bold text-[#006ce4]"><%= @neighborhood.name %></span>
          <% end %>
          <span>&bull;</span>
          <span class="font-black text-slate-900"><%= @city.name %> - <%= @state.acronym %></span>
          <span>&bull;</span>
          <a href="#sobre-empresa" class="font-extrabold text-[#006ce4] hover:underline">Excelente localização - ver mapa</a>
        </div>

        <% unless is_main_cnae_lodging %>
          <div class="bg-amber-50 border border-amber-200/90 rounded-xl p-4 text-amber-950 space-y-1 mt-3">
            <div class="flex items-center gap-1.5 font-extrabold text-amber-950 text-xs sm:text-sm">
              <span>ℹ️</span>
              <span>Sobre a listagem desta empresa no Hospedagem Direta</span>
            </div>
            <p class="text-xs leading-relaxed text-slate-700 font-medium">
              Esta empresa possui em seu cadastro oficial de operações (CNAE Secundário na Receita Federal) atividades relacionadas ao setor de hospedagem, hotéis, pousadas, hostels ou alojamentos.
            </p>
          </div>
        <% end %>
      </div>

      <!-- Top Right Actions (Favorite, Share, Primary Contact Button) -->
      <div class="flex items-center gap-2 shrink-0 flex-wrap">
        <% if !user_signed_in? || current_user.client? %>
          <% if user_signed_in? && current_user.client? %>
            <%= button_to toggle_favorite_path(company_id: @company.id), method: :post, data: { turbo: false },
                class: "inline-flex items-center justify-center w-10 h-10 rounded-full border text-base transition-all shadow-2xs #{ current_user.favorited?(@company) ? 'bg-rose-50 border-rose-200 text-rose-600' : 'bg-slate-50 border-slate-200 text-slate-700 hover:bg-slate-100' }",
                title: current_user.favorited?(@company) ? "Remover dos favoritos" : "Salvar nos favoritos" do %>
              <span><%= current_user.favorited?(@company) ? "❤️" : "🤍" %></span>
            <% end %>
          <% else %>
            <a href="<%= new_user_session_path %>" class="inline-flex items-center justify-center w-10 h-10 rounded-full border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-700 text-base transition-all shadow-2xs" title="Faça login para salvar nos favoritos">
              <span>🤍</span>
            </a>
          <% end %>
        <% end %>

        <% if @company.has_whatsapp? %>
          <% if user_signed_in? %>
            <a href="<%= @company.whatsapp_url %>" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-[#006ce4] hover:bg-[#0057b8] text-white font-extrabold text-sm px-6 py-2.5 rounded-xl shadow-md transition-all">
              <span>📱 Reservar Direto</span>
            </a>
          <% else %>
            <a href="<%= new_user_session_path %>" class="inline-flex items-center gap-2 bg-[#006ce4] hover:bg-[#0057b8] text-white font-extrabold text-sm px-6 py-2.5 rounded-xl shadow-md transition-all">
              <span>🔒 Reservar Direto</span>
            </a>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Photo Gallery Section -->
    <%
      all_gallery_photos = []

      # 1. Company Property Photos
      if @company.photos.attached? && @company.photos.any?
        @company.photos.each_with_index do |photo, idx|
          all_gallery_photos << {
            url: rails_blob_path(photo, only_path: true),
            title: trade_name_display,
            subtitle: idx == 0 ? "Foto Principal da Propriedade" : "Foto da Propriedade (#{idx + 1})",
            badge: "📸 Propriedade",
            source: "company"
          }
        end
      end
      has_real_photos = all_gallery_photos.any?
      display_photos = all_gallery_photos.map { |p| p[:url] }
    %>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-start">
      <!-- Main Photo Grid (Col 1 to 8) -->
      <div class="lg:col-span-8 space-y-3">
        <% if has_real_photos %>
          <!-- Real Photos Grid -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3 h-72 sm:h-80 md:h-[380px]" style="min-height: 288px; max-height: 380px;">
            <!-- Big Cover Photo (Left 2 cols or 3 cols if 1 photo) -->
            <div class="<%= display_photos.size == 1 ? 'md:col-span-3' : 'md:col-span-2' %> h-full rounded-2xl overflow-hidden bg-slate-900 border border-slate-200 shadow-sm relative group cursor-pointer" onclick="openPhotoModal(0)">
              <img src="<%= display_photos[0] %>" alt="<%= trade_name_display %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
              <span class="absolute bottom-3 left-3 bg-slate-900/80 text-white text-xs font-extrabold px-3 py-1.5 rounded-xl backdrop-blur-xs flex items-center gap-1.5 shadow-sm z-10">
                <span><%= all_gallery_photos[0][:badge] %></span>
              </span>
              <span class="absolute top-3 right-3 bg-slate-900/70 group-hover:bg-blue-600 text-white text-xs font-extrabold px-3 py-1.5 rounded-xl backdrop-blur-xs flex items-center gap-1.5 transition-all shadow-sm z-10">
                <span>🔍 Ver fotos (<%= all_gallery_photos.size %>)</span>
              </span>
            </div>

            <!-- Stacked Photos (Right col) -->
            <% if display_photos.size > 1 %>
              <div class="hidden md:flex flex-col gap-3 h-full overflow-hidden">
                <% if display_photos.size == 2 %>
                  <div class="h-full rounded-2xl overflow-hidden bg-slate-900 border border-slate-200 shadow-sm relative group cursor-pointer" onclick="openPhotoModal(1)">
                    <img src="<%= display_photos[1] %>" alt="<%= trade_name_display %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                    <span class="absolute bottom-2 left-2 bg-slate-900/80 text-white text-[10px] font-bold px-2 py-0.5 rounded-md backdrop-blur-xs z-10">
                      <%= all_gallery_photos[1][:badge] %>
                    </span>
                  </div>
                <% else %>
                  <div class="h-[calc(50%-6px)] rounded-2xl overflow-hidden bg-slate-900 border border-slate-200 shadow-sm relative group cursor-pointer" onclick="openPhotoModal(1)">
                    <img src="<%= display_photos[1] %>" alt="<%= trade_name_display %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                    <span class="absolute bottom-2 left-2 bg-slate-900/80 text-white text-[10px] font-bold px-2 py-0.5 rounded-md backdrop-blur-xs z-10">
                      <%= all_gallery_photos[1][:badge] %>
                    </span>
                  </div>
                  <div class="h-[calc(50%-6px)] rounded-2xl overflow-hidden bg-slate-900 border border-slate-200 shadow-sm relative group cursor-pointer" onclick="openPhotoModal(2)">
                    <img src="<%= display_photos[2] %>" alt="<%= trade_name_display %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                    <span class="absolute bottom-2 left-2 bg-slate-900/80 text-white text-[10px] font-bold px-2 py-0.5 rounded-md backdrop-blur-xs z-10">
                      <%= all_gallery_photos[2][:badge] %>
                    </span>
                    <% if display_photos.size > 3 %>
                      <div class="absolute inset-0 bg-slate-950/60 flex items-center justify-center text-white text-xs font-black tracking-wider uppercase text-center p-1 backdrop-blur-2xs z-20">
                        +<%= display_photos.size - 3 %> <%= (display_photos.size - 3) == 1 ? "foto" : "fotos" %>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>

          <!-- Bottom Thumbnails Row (Only rendered if there are more than 3 photos) -->
          <% if display_photos.size > 3 %>
            <div class="grid grid-cols-4 sm:grid-cols-6 gap-2.5 h-20 pt-1">
              <% display_photos.each_with_index do |photo_url, idx| %>
                <% next if idx < 3 %>
                <div class="h-full rounded-xl overflow-hidden bg-slate-900 border border-slate-200 relative group cursor-pointer" onclick="openPhotoModal(<%= idx %>)">
                  <img src="<%= photo_url %>" alt="<%= trade_name_display %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300">
                  <span class="absolute bottom-1 left-1 bg-slate-900/80 text-white text-[9px] font-extrabold px-1.5 py-0.5 rounded backdrop-blur-2xs truncate max-w-[90%] z-10">
                    <%= all_gallery_photos[idx][:badge] %>
                  </span>
                </div>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <!-- No Photos Uploaded Placeholder -->
          <div class="h-[280px] rounded-2xl overflow-hidden bg-slate-900 border border-slate-800 shadow-sm relative flex flex-col items-center justify-center p-6 text-center text-white">
            <span class="text-5xl mb-3">🔧</span>
            <h4 class="text-base font-bold text-slate-200 mb-1"><%= trade_name_display %></h4>
            <p class="text-xs text-slate-400 max-w-md">Oficina sem fotos cadastradas ainda. É o proprietário? Reivindique este perfil gratuitamente para adicionar fotos, horário de funcionamento e WhatsApp direto.</p>
            <% if can_claim_company? %>
              <%= link_to "Reivindicar Perfil Grátis", new_claim_path(cnpj: @company.cnpj), class: "mt-4 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-xs px-4 py-2 rounded-xl transition-all shadow" %>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- Right Summary & Real Rating Box (Col 9 to 12) -->
      <div class="lg:col-span-4 space-y-4 flex flex-col justify-between">
        <!-- Review Score Card (Real System) -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-2xs space-y-4">
          <% if score_info[:has_reviews] %>
            <div class="flex items-start justify-between gap-3">
              <div>
                <span class="text-[11px] font-extrabold text-slate-500 uppercase tracking-wider block mb-0.5">Avaliação dos Hóspedes</span>
                <h3 class="font-extrabold text-slate-900 text-lg leading-tight">
                  <%= score_info[:label] %>
                </h3>
                <p class="text-xs text-slate-500 font-medium"><%= score_info[:count] %> <%= score_info[:count] == 1 ? "avaliação real" : "avaliações reais" %></p>
              </div>
              <div class="bg-[#003580] text-white text-base font-black px-3.5 py-1.5 rounded-xl text-center shadow-2xs flex items-center gap-1">
                <span>★</span>
                <span><%= score_info[:score] %></span>
              </div>
            </div>

            <% last_review = @company.reviews.order(created_at: :desc).first %>
            <% if last_review.present? && last_review.comment.present? %>
              <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-3.5 space-y-2">
                <p class="text-xs text-slate-700 italic leading-relaxed">
                  "<%= last_review.comment %>"
                </p>
                <div class="flex items-center justify-between text-[11px] font-bold text-slate-600">
                  <span class="text-slate-800"><%= last_review.reviewer_name %></span>
                  <span class="text-amber-500">★ <%= last_review.rating %></span>
                </div>
              </div>
            <% end %>

            <a href="#reviews-section" class="block text-center text-xs font-extrabold text-[#006ce4] hover:underline pt-2 border-t border-slate-100">
              Ver todas as <%= score_info[:count] %> avaliações &rarr;
            </a>
          <% else %>
            <div class="text-center py-2 space-y-3">
              <span class="text-3xl">⭐</span>
              <div>
                <h3 class="font-extrabold text-slate-900 text-base">Ainda não avaliado</h3>
                <p class="text-xs text-slate-500 mt-1">Seja o primeiro a avaliar a estadia neste estabelecimento!</p>
              </div>
              <a href="#review-form" class="inline-block bg-amber-400 hover:bg-amber-500 text-slate-950 font-extrabold text-xs px-4 py-2 rounded-xl transition-all shadow-2xs">
                ✍️ Avaliar Hospedagem
              </a>
            </div>
          <% end %>
        </div>

        <!-- Endorsements & Highlights Card (Recomendações dos Hóspedes & Destaques) -->
        <div class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-2xs space-y-3">
          <h3 class="text-xs font-black uppercase tracking-wider text-slate-500 flex items-center gap-1.5 border-b border-slate-100 pb-2">
            <span>🏷️</span>
            <span>Recomendações &amp; Destaques</span>
          </h3>

          <% all_tags = @company.reviews.flat_map { |r| Array(r.tags) }.reject(&:blank?) %>
          <% endorsement_counts = all_tags.tally.sort_by { |_tag, count| -count } %>

          <% if endorsement_counts.any? %>
            <div class="flex flex-wrap gap-2 pt-0.5">
              <% endorsement_counts.first(3).each do |tag, count| %>
                <div class="inline-flex items-center gap-1.5 bg-emerald-50 border border-emerald-200/80 text-emerald-900 text-xs font-extrabold px-2.5 py-1.5 rounded-xl shadow-2xs">
                  <span><%= Review.tag_icon(tag) %></span>
                  <span><%= tag %></span>
                  <span class="bg-emerald-200 text-emerald-950 text-[10px] px-1.5 py-0.2 rounded-full font-black"><%= count %></span>
                </div>
              <% end %>
              <% remaining_tags = endorsement_counts.size - 3 %>
              <% if remaining_tags > 0 %>
                <a href="#reviews-section" class="inline-flex items-center gap-1 bg-slate-100 hover:bg-slate-200 border border-slate-200 text-slate-700 text-xs font-black px-2.5 py-1.5 rounded-xl transition-colors" title="Ver todas as recomendações">
                  <span>+ <%= remaining_tags %></span>
                </a>
              <% end %>
            </div>
          <% else %>
            <!-- Highlights -->
            <% highlights = [] %>
            <% highlights << { icon: "⚡", name: "Contato Direto 0% Taxas", bg: "bg-emerald-50 border-emerald-200/80 text-emerald-900" } %>
            <% highlights << { icon: "💬", name: "WhatsApp Direto", bg: "bg-blue-50 border-blue-200/80 text-blue-900" } %>

            <div class="flex flex-wrap gap-2 pt-0.5">
              <% highlights.first(3).each do |item| %>
                <div class="inline-flex items-center gap-1.5 <%= item[:bg] %> border text-xs font-extrabold px-2.5 py-1.5 rounded-xl shadow-2xs">
                  <span><%= item[:icon] %></span>
                  <span><%= item[:name] %></span>
                </div>
              <% end %>
              <% remaining_highlights = highlights.size - 3 %>
              <% if remaining_highlights > 0 %>
                <a href="#instalacoes-servicos" class="inline-flex items-center gap-1 bg-slate-100 hover:bg-slate-200 border border-slate-200 text-slate-700 text-xs font-black px-2.5 py-1.5 rounded-xl transition-colors" title="Ver todos os destaques">
                  <span>+ <%= remaining_highlights %></span>
                </a>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Map Snippet Box -->
        <div class="bg-slate-900 rounded-2xl overflow-hidden border border-slate-200 relative h-36 group cursor-pointer" onclick="document.getElementById('sobre-empresa').scrollIntoView({behavior: 'smooth'})">
          <img src="https://images.unsplash.com/photo-1524661135-423995f22d0b?auto=format&fit=crop&w=600&q=80" alt="Mapa" class="w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-500">
          <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 p-3 text-center">
