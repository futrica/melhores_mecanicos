                  <summary class="flex items-center justify-between p-4 cursor-pointer font-bold text-sm text-slate-900 group-open:bg-slate-100/80 transition-colors">
                    <span><%= sanitize(item[:question], tags: %w[strong]) %></span>
                    <span class="text-slate-400 group-open:rotate-180 transition-transform text-xs">▼</span>
                  </summary>
                  <div class="p-4 pt-2 text-xs sm:text-sm text-slate-600 leading-relaxed border-t border-slate-200/60 bg-white">
                    <p><%= sanitize(item[:answer], tags: %w[strong]) %></p>
                  </div>
                </details>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>


