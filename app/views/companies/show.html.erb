          </div>
        <% end %>

        <!-- Review Form Container -->
        <div id="review-form" class="pt-4 border-t border-slate-100 space-y-3">
          <h3 class="font-extrabold text-base text-slate-900 flex items-center gap-2">
            <span>✍️</span>
            <span>⭐ Avaliar Hospedagem</span>
          </h3>
          <% if user_signed_in? && current_user.client? %>
            <% if current_user.reviewed?(@company) %>
              <div class="bg-emerald-50 border border-emerald-200 text-emerald-900 p-4 rounded-xl font-bold text-xs">
                ✅ Você já enviou sua avaliação para esta hospedagem. Muito obrigado por colaborar com a comunidade!
              </div>
            <% else %>
              <div class="bg-slate-50 border border-slate-200 p-6 rounded-2xl space-y-4">
                <h3 class="font-extrabold text-base text-slate-900">Enviar Sua Avaliação de Hóspede</h3>
                <p class="text-xs text-slate-600">Selecione sua nota de 1 a 5 estrelas e recomende os principais diferenciais da hospedagem.</p>
                
                <%= form_with url: company_reviews_path(@company), model: @new_review, local: true, class: "space-y-4" do |f| %>
                  <% if @new_review&.errors&.any? %>
                    <div class="bg-rose-50 border border-rose-200 text-rose-800 p-3 rounded-xl text-xs space-y-1">
                      <% @new_review.errors.full_messages.each do |msg| %>
                        <p>&bull; <%= msg %></p>
                      <% end %>
                    </div>
                  <% end %>

                  <div class="space-y-1.5" data-controller="star-rating">
                    <div class="flex items-center justify-between">
                      <label class="text-xs font-bold text-slate-700 block">Sua nota <span class="text-rose-500">*</span></label>
                      <span class="text-xs font-extrabold text-amber-600" data-star-rating-target="label">Clique para escolher de 1 a 5 estrelas</span>
                    </div>
                    <div class="flex items-center gap-1.5 py-1">
                      <% (1..5).each do |i| %>
                        <label class="cursor-pointer text-3xl text-slate-300 transition-transform duration-150 hover:scale-125 select-none"
                               data-star-rating-target="star"
                               data-rating="<%= i %>"
                               data-action="mouseenter->star-rating#hover mouseleave->star-rating#reset">
                          <input type="radio" 
                                 name="review[rating]" 
                                 value="<%= i %>" 
                                 class="sr-only" 
                                 required 
                                 data-star-rating-target="input" 
                                 data-action="change->star-rating#change"
                                 <%= "checked" if @new_review&.rating == i %>>
                          <span>★</span>
                        </label>
                      <% end %>
                    </div>
                  </div>

                  <div class="space-y-2">
                    <label class="text-xs font-bold text-slate-700 block">Recomendações e Destaques (Opcional)</label>
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                      <% Review::POSITIVE_TAGS.each_with_index do |tag, idx| %>
                        <label class="flex items-center gap-2 bg-white border border-slate-200 hover:border-blue-400 p-2.5 rounded-xl text-xs font-bold cursor-pointer transition-colors">
                          <%= f.check_box :tags, { multiple: true, id: "tag_#{idx}", class: "rounded text-blue-600 focus:ring-blue-500" }, tag, nil %>
                          <span><%= Review.tag_icon(tag) %> <%= tag %></span>
                        </label>
                      <% end %>
                    </div>
                  </div>

                  <button type="submit" class="w-full bg-[#006ce4] hover:bg-[#0052b4] text-white font-extrabold text-sm py-3 px-6 rounded-xl shadow transition-all flex items-center justify-center gap-2">
                    <span>Enviar Avaliação</span>
                    <span>🚀</span>
                  </button>
                <% end %>
              </div>
            <% end %>
          <% elsif !user_signed_in? %>
            <div class="bg-slate-50 border border-slate-200 p-6 rounded-2xl text-center space-y-3">
              <h3 class="font-extrabold text-base text-slate-900">Avaliar Esta Hospedagem</h3>
              <p class="text-xs text-slate-600 max-w-md mx-auto">Faça login com sua conta de cliente para compartilhar sua experiência e avaliar o local.</p>
              <a href="<%= new_user_session_path %>" class="inline-block bg-[#006ce4] hover:bg-[#0052b4] text-white font-extrabold text-xs py-2.5 px-5 rounded-xl shadow transition-all">
                🔒 Faça Login para Avaliar
              </a>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Section: Related Lodging Properties (Free Plan Only - Hidden on Premium Profiles) -->
      <% if @company.free_plan? && (@related_neighborhood_companies.any? || @related_city_companies.any? || @related_general_companies.any?) %>
        <div class="bg-white border border-slate-200/90 rounded-2xl p-6 sm:p-8 shadow-sm space-y-6" id="hospedagens-relacionadas">
          <h2 class="text-xl font-black text-slate-900 flex items-center gap-2 border-b border-slate-100 pb-3">
            <span>🏢</span>
            <span>Outras Hospedagens em <%= @city.name %> - <%= @state.acronym %></span>
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            <% (@related_neighborhood_companies + @related_city_companies + @related_general_companies).uniq.first(6).each do |rel| %>
              <a href="<%= company_seo_path(rel) %>" class="bg-slate-50 border border-slate-200/80 hover:border-blue-500 p-4 rounded-xl transition-all hover:shadow-md group flex flex-col justify-between space-y-3">
                <div>
                  <h4 class="font-extrabold text-sm text-slate-900 group-hover:text-blue-600 transition-colors leading-snug">
                    <%= rel.trade_name.presence || rel.legal_name %>
                  </h4>
                  <p class="text-xs text-slate-500 mt-1 font-medium">
                    📍 <%= rel.neighborhood&.name || "Centro" %> &bull; <%= rel.city.name %>/<%= rel.state.acronym %>
                  </p>
                </div>

                <div class="flex items-center justify-between text-xs pt-2 border-t border-slate-200/60">
                  <span class="text-emerald-700 font-extrabold text-[11px]">⚡ Reserva Direta</span>
                  <span class="font-bold text-blue-600">Ver &rarr;</span>
                </div>
              </a>
            <% end %>
          </div>
        </div>
      <% end %>

    </div>

    <!-- Right Sidebar (4 Cols) -->
    <aside class="lg:col-span-4 space-y-6 sticky top-6">

      <% if !@company.approved? && !@company.is_claimed? && can_claim_company? %>
        <!-- Owner Claim Box (Only shown if company is unclaimed / not approved) -->
        <div class="bg-gradient-to-br from-blue-950 via-slate-900 to-blue-900 text-white rounded-2xl p-6 shadow-md border border-blue-800/40 space-y-4">
          <div class="flex items-center gap-2 text-emerald-400 font-extrabold text-xs uppercase tracking-wider">
            <span>🏨 Proprietário ou Gerente</span>
          </div>

          <h3 class="text-lg font-black leading-snug text-white">
            É o dono desta hospedagem?
          </h3>

          <p class="text-xs text-blue-100 leading-relaxed">
            Reivindique o perfil de <strong><%= trade_name_display %></strong> gratuitamente. Adicione seu WhatsApp oficial, atualize fotos e receba pedidos de reserva direto sem pagar comissão!
          </p>

          <a href="<%= new_claim_path(company_id: @company.id) %>" class="block w-full bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-xs py-3 px-4 rounded-xl text-center shadow-md transition-all">
            ⚡ Reivindicar Perfil Gratuitamente
          </a>
        </div>
      <% end %>

      <!-- Direct Booking Card Summary -->
      <div class="bg-white border border-slate-200/90 rounded-2xl p-6 shadow-sm space-y-4">
        <h3 class="font-black text-base text-slate-900 flex items-center gap-1.5">
          <span>⚡</span>
          <span>Por que Reservar Direto?</span>
        </h3>

        <ul class="space-y-2.5 text-xs text-slate-600">
          <li class="flex items-start gap-2">
            <span class="text-emerald-600 font-bold text-sm">✓</span>
            <span><strong>0% de Taxas:</strong> Garantia do menor valor por diária.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-600 font-bold text-sm">✓</span>
            <span><strong>Contato Imediato:</strong> Converse no WhatsApp com a recepção.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-emerald-600 font-bold text-sm">✓</span>
            <span><strong>Flexibilidade:</strong> Combine horários e pedidos especiais sem intermediários.</span>
          </li>
        </ul>
      </div>

      <!-- AdSense Sidebar Banner Slot (Free Plan Only) -->
      <% if @company.free_plan? %>
        <%= adsense_ad_tag(:sidebar) %>
      <% end %>

    </aside>

  </div>

</div>

<!-- Property Photo Lightbox Modal (Full Featured Carousel) -->
<div id="photo-lightbox-modal" class="hidden fixed inset-0 z-50 overflow-hidden bg-slate-950/95 backdrop-blur-md flex flex-col justify-between p-3 sm:p-6 select-none" onclick="handleLightboxBackdropClick(event)">
  
  <!-- Top Bar: Counter, Badge & Controls -->
  <div class="flex items-center justify-between gap-4 z-50 w-full max-w-7xl mx-auto pt-1 px-2">
    <div class="flex items-center gap-2 sm:gap-3 flex-wrap">
      <span id="lightbox-badge" class="bg-blue-600/90 text-white text-xs font-extrabold px-3 py-1.5 rounded-full backdrop-blur-xs border border-blue-400/30 flex items-center gap-1.5 shadow-sm">
        📸 Propriedade
      </span>
      <span id="lightbox-counter" class="text-slate-300 text-xs sm:text-sm font-bold bg-slate-900/80 px-3 py-1.5 rounded-full border border-slate-700/60">
        Foto 1 de 1
      </span>
    </div>

    <div class="flex items-center gap-2">
      <button type="button" onclick="toggleLightboxZoom()" title="Alternar Zoom" class="text-slate-300 hover:text-white bg-slate-900/80 hover:bg-slate-800 border border-slate-700/60 w-10 h-10 rounded-full flex items-center justify-center font-bold text-base transition-all shadow-md">
        🔍
      </button>
      <button type="button" onclick="closePhotoModal()" title="Fechar (ESC)" class="text-white hover:text-slate-200 bg-rose-600/80 hover:bg-rose-600 w-10 h-10 rounded-full flex items-center justify-center font-black text-lg transition-all shadow-lg border border-rose-500/40">
        ✕
      </button>
    </div>
  </div>

  <!-- Center Area: Prev Button, Image Viewport, Next Button -->
  <div class="relative flex-1 flex items-center justify-center w-full max-w-7xl mx-auto my-2 px-2 overflow-hidden">
    
    <!-- Prev Button -->
    <button type="button" id="lightbox-prev" onclick="prevPhoto(event)" title="Foto anterior (Seta Esquerda)" class="absolute left-2 sm:left-4 z-40 text-white bg-slate-900/80 hover:bg-blue-600 border border-slate-700/80 hover:border-blue-500 w-12 h-12 sm:w-14 sm:h-14 rounded-full flex items-center justify-center font-black text-xl sm:text-2xl transition-all shadow-xl hover:scale-110 active:scale-95 cursor-pointer">
      ❮
    </button>

    <!-- Main Display Container -->
    <div id="lightbox-img-container" class="relative max-h-[72vh] max-w-full flex items-center justify-center overflow-hidden transition-all">
      <img id="lightbox-img" src="" alt="" class="max-h-[72vh] max-w-full rounded-2xl object-contain shadow-2xl border border-slate-800 transition-all duration-300 cursor-zoom-in" onclick="toggleLightboxZoom()">
    </div>

    <!-- Next Button -->
    <button type="button" id="lightbox-next" onclick="nextPhoto(event)" title="Próxima foto (Seta Direita)" class="absolute right-2 sm:right-4 z-40 text-white bg-slate-900/80 hover:bg-blue-600 border border-slate-700/80 hover:border-blue-500 w-12 h-12 sm:w-14 sm:h-14 rounded-full flex items-center justify-center font-black text-xl sm:text-2xl transition-all shadow-xl hover:scale-110 active:scale-95 cursor-pointer">
      ❯
    </button>

  </div>

  <!-- Bottom Bar: Title, Subtitle & Thumbnails Strip -->
  <div class="w-full max-w-7xl mx-auto space-y-3 z-50 px-2 pb-1">
    
    <!-- Caption / Details -->
    <div class="text-center space-y-0.5 max-w-2xl mx-auto">
      <h4 id="lightbox-title" class="text-white text-base sm:text-lg font-black tracking-tight drop-shadow-md"></h4>
      <p id="lightbox-subtitle" class="text-slate-300 text-xs sm:text-sm font-semibold drop-shadow-sm"></p>
    </div>

    <!-- Thumbnail Strip -->
    <div id="lightbox-thumbnails-container" class="flex items-center justify-center gap-2 overflow-x-auto py-2 px-1 scrollbar-none max-w-4xl mx-auto">
      <!-- Thumbnails rendered dynamically -->
    </div>

  </div>
</div>

<script>
  var globalPropertyPhotos = <%= raw all_gallery_photos.to_json %>;
  var currentPhotoIdx = 0;
  var isZoomed = false;

  function initLightboxThumbnails() {
    var container = document.getElementById('lightbox-thumbnails-container');
    if (!container) return;
    container.innerHTML = '';
    
    globalPropertyPhotos.forEach(function(photo, idx) {
      var thumb = document.createElement('img');
      thumb.src = photo.url;
      thumb.alt = photo.title || '';
      thumb.id = 'lightbox-thumb-' + idx;
      thumb.className = 'w-14 h-10 sm:w-18 sm:h-12 object-cover rounded-xl cursor-pointer transition-all border-2 border-slate-700/80 opacity-50 hover:opacity-100 flex-shrink-0';
      thumb.onclick = function(e) {
        e.stopPropagation();
        openPhotoModal(idx);
      };
      container.appendChild(thumb);
    });
  }

  function updateLightboxPhoto() {
    if (!globalPropertyPhotos || globalPropertyPhotos.length === 0) return;
    
    if (currentPhotoIdx < 0) currentPhotoIdx = globalPropertyPhotos.length - 1;
    if (currentPhotoIdx >= globalPropertyPhotos.length) currentPhotoIdx = 0;

    var photo = globalPropertyPhotos[currentPhotoIdx];
    var img = document.getElementById('lightbox-img');
    var badge = document.getElementById('lightbox-badge');
    var counter = document.getElementById('lightbox-counter');
    var title = document.getElementById('lightbox-title');
    var subtitle = document.getElementById('lightbox-subtitle');

    if (img) {
      img.src = photo.url;
      img.alt = photo.title || '';
    }
    if (badge) {
      badge.textContent = photo.badge || '📸 Foto';
    }
    if (counter) {
      counter.textContent = 'Foto ' + (currentPhotoIdx + 1) + ' de ' + globalPropertyPhotos.length;
    }
    if (title) {
      title.textContent = photo.title || '';
    }
    if (subtitle) {
      subtitle.textContent = photo.subtitle || '';
      subtitle.style.display = photo.subtitle ? 'block' : 'none';
    }

    if (isZoomed) {
      toggleLightboxZoom(false);
    }

    globalPropertyPhotos.forEach(function(_, idx) {
      var thumb = document.getElementById('lightbox-thumb-' + idx);
      if (thumb) {
        if (idx === currentPhotoIdx) {
          thumb.className = 'w-14 h-10 sm:w-18 sm:h-12 object-cover rounded-xl cursor-pointer transition-all border-2 border-emerald-400 opacity-100 scale-105 shadow-lg flex-shrink-0 ring-2 ring-emerald-500/50';
          thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        } else {
          thumb.className = 'w-14 h-10 sm:w-18 sm:h-12 object-cover rounded-xl cursor-pointer transition-all border-2 border-slate-700/80 opacity-50 hover:opacity-100 flex-shrink-0';
        }
      }
    });

    var prevBtn = document.getElementById('lightbox-prev');
    var nextBtn = document.getElementById('lightbox-next');
    if (prevBtn && nextBtn) {
      if (globalPropertyPhotos.length <= 1) {
        prevBtn.style.display = 'none';
        nextBtn.style.display = 'none';
      } else {
        prevBtn.style.display = 'flex';
        nextBtn.style.display = 'flex';
      }
    }
  }

  function openPhotoModal(idx) {
    currentPhotoIdx = (typeof idx === 'number') ? idx : 0;
    var modal = document.getElementById('photo-lightbox-modal');
    if (!modal) return;
    
    initLightboxThumbnails();
    updateLightboxPhoto();
    
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closePhotoModal() {
    var modal = document.getElementById('photo-lightbox-modal');
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }
    if (isZoomed) {
      toggleLightboxZoom(false);
    }
  }

  function prevPhoto(e) {
    if (e) e.stopPropagation();
    currentPhotoIdx--;
    updateLightboxPhoto();
  }

  function nextPhoto(e) {
    if (e) e.stopPropagation();
    currentPhotoIdx++;
    updateLightboxPhoto();
  }

  function toggleLightboxZoom(forceState) {
    var img = document.getElementById('lightbox-img');
    var container = document.getElementById('lightbox-img-container');
    if (!img || !container) return;
    
    if (typeof forceState === 'boolean') {
      isZoomed = forceState;
    } else {
      isZoomed = !isZoomed;
    }

    if (isZoomed) {
      img.classList.remove('max-h-[72vh]', 'object-contain', 'cursor-zoom-in');
      img.classList.add('max-h-none', 'max-w-none', 'w-auto', 'h-auto', 'cursor-zoom-out');
      container.classList.add('overflow-auto');
    } else {
      img.classList.remove('max-h-none', 'max-w-none', 'w-auto', 'h-auto', 'cursor-zoom-out');
      img.classList.add('max-h-[72vh]', 'object-contain', 'cursor-zoom-in');
      container.classList.remove('overflow-auto');
    }
  }

  function handleLightboxBackdropClick(e) {
    if (e.target.id === 'photo-lightbox-modal' || e.target.id === 'lightbox-img-container') {
      closePhotoModal();
    }
  }

  document.addEventListener('keydown', function(e) {
    var modal = document.getElementById('photo-lightbox-modal');
    if (!modal || modal.classList.contains('hidden')) return;

    if (e.key === 'Escape') {
      closePhotoModal();
    } else if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') {
      prevPhoto();
    } else if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') {
      nextPhoto();
    }
  });

  document.addEventListener('DOMContentLoaded', function() {
    var lightboxViewport = document.getElementById('lightbox-img-container');
    if (lightboxViewport) {
      var touchStartX = 0;
      var touchEndX = 0;
      lightboxViewport.addEventListener('touchstart', function(e) {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      lightboxViewport.addEventListener('touchend', function(e) {
        touchEndX = e.changedTouches[0].screenX;
        var diffX = touchEndX - touchStartX;
        if (Math.abs(diffX) > 40) {
          if (diffX < 0) {
            nextPhoto();
          } else {
            prevPhoto();
          }
        }
      }, { passive: true });
    }
  });
</script>
